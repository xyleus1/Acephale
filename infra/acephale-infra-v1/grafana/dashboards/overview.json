{
  "uid": "acephale-infra-v1", "title": "Acephale infrastructure: measured results", "schemaVersion": 39, "version": 1,
  "editable": false, "timezone": "utc", "refresh": "10s", "time": {"from": "now-1h", "to": "now"},
  "tags": ["acephale", "research"],
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "text", "title": "Interpretation", "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "No data means unmeasured, not zero. Compare matched task cohorts and seeds. Native success, prediction accuracy and speculative usefulness have different denominators. Timing includes prediction, validation and contention. Replay timing is not live latency."}},
    {"id": 2, "type": "timeseries", "title": "Task latency: observed p50 and p95 (seconds)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, arm) (rate(acephale_task_duration_seconds_bucket[5m])))", "legendFormat": "{{arm}} p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, arm) (rate(acephale_task_duration_seconds_bucket[5m])))", "legendFormat": "{{arm}} p95"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Completed tasks by outcome", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (arm, outcome) (acephale_tasks_total)", "legendFormat": "{{arm}} {{outcome}}"}]},
    {"id": 4, "type": "timeseries", "title": "Physical calls, authoritative calls and revalidation", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (arm, kind) (acephale_tool_calls_total)", "legendFormat": "{{arm}} {{kind}}"}]},
    {"id": 5, "type": "timeseries", "title": "Speculation outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (arm, outcome) (acephale_speculation_total)", "legendFormat": "{{arm}} {{outcome}}"}]},
    {"id": 6, "type": "timeseries", "title": "Exact prediction outcomes", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (arm, outcome) (acephale_prediction_total)", "legendFormat": "{{arm}} {{outcome}}"}]},
    {"id": 7, "type": "timeseries", "title": "Annotation agreement outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome) (acephale_goal_agreement_total)", "legendFormat": "{{outcome}}"}]},
    {"id": 8, "type": "timeseries", "title": "Known cost and outstanding reservations", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "acephale_spend_usd", "legendFormat": "{{category}} known"}, {"refId": "B", "expr": "acephale_reserved_usd", "legendFormat": "{{category}} reserved"}], "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "Inference queue and running requests", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "vllm:num_requests_waiting", "legendFormat": "{{job}} waiting"}, {"refId": "B", "expr": "vllm:num_requests_running", "legendFormat": "{{job}} running"}]},
    {"id": 10, "type": "logs", "title": "Structured lifecycle events", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{job=\"acephale\"}"}], "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
