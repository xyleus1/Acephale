{
  "global": {"scrape_interval": "10s", "evaluation_interval": "10s"},
  "rule_files": ["/etc/prometheus/alerts.json"],
  "scrape_configs": [
    {"job_name": "acephale", "static_configs": [{"targets": ["acephale-runtime:4319"]}]},
    {"job_name": "actor-vllm", "static_configs": [{"targets": ["actor:8000"]}]},
    {"job_name": "predictor-vllm", "static_configs": [{"targets": ["predictor:8000"]}]},
    {"job_name": "alloy", "static_configs": [{"targets": ["alloy:12345"]}]}
  ]
}
