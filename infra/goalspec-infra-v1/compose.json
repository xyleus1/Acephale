{
  "name": "goalspec-infra-v1",
  "services": {
    "postgres": {
      "image": "${GOALSPEC_POSTGRES_IMAGE:-pgvector/pgvector:0.8.7-pg17}",
      "profiles": ["cpu", "gpu"],
      "environment": {"POSTGRES_DB": "goalspec_research", "POSTGRES_USER": "goalspec", "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password"},
      "secrets": ["postgres_password"],
      "volumes": ["research-db:/var/lib/postgresql/data", "../../services/goalspec-runtime/schema.sql:/docker-entrypoint-initdb.d/001-goalspec.sql:ro", "../../services/goalspec-runtime/migrations/002-episodic-memory.sql:/docker-entrypoint-initdb.d/002-episodic-memory.sql:ro"],
      "networks": ["research"],
      "healthcheck": {"test": ["CMD-SHELL", "pg_isready -U goalspec -d goalspec_research"], "interval": "5s", "timeout": "3s", "retries": 12},
      "mem_limit": "2g", "cpus": 2, "restart": "no"
    },
    "goalspec-runtime": {
      "build": {"context": "../..", "dockerfile": "infra/goalspec-infra-v1/runtime.Dockerfile", "args": {"NODE_IMAGE": "${GOALSPEC_NODE_IMAGE:-node:22.23.4-bookworm-slim}"}},
      "profiles": ["runtime"],
      "command": ["serve"],
      "ports": ["127.0.0.1:4319:4319"],
      "environment": {"GOALSPEC_PORT": "4319", "GOALSPEC_HOST": "0.0.0.0", "GOALSPEC_ACTOR_BASE_URL": "http://actor:8000/v1", "GOALSPEC_PREDICTOR_BASE_URL": "http://predictor:8000/v1", "OTEL_EXPORTER_OTLP_ENDPOINT": "http://alloy:4318", "GOALSPEC_ARTIFACT_DIR": "/artifacts", "GOALSPEC_POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password", "GOALSPEC_POSTGRES_HOST": "postgres", "GOALSPEC_POSTGRES_DATABASE": "goalspec_research", "GOALSPEC_POSTGRES_USER": "goalspec"},
      "secrets": ["postgres_password"],
      "volumes": ["${GOALSPEC_ARTIFACTS_DIR:-./artifacts}:/artifacts"],
      "networks": ["research", "egress"],
      "mem_limit": "2g", "cpus": 2, "read_only": true, "tmpfs": ["/tmp:rw,noexec,nosuid,size=128m"], "security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "restart": "no"
    },
    "python-worker": {
      "build": {"context": "../..", "dockerfile": "infra/goalspec-infra-v1/worker.Dockerfile", "args": {"PYTHON_IMAGE": "${GOALSPEC_PYTHON_IMAGE:-python:3.12.16-slim-bookworm}"}},
      "profiles": ["worker"],
      "volumes": ["${GOALSPEC_ARTIFACTS_DIR:-./artifacts}:/artifacts"],
      "networks": ["research", "egress"], "mem_limit": "3g", "cpus": 2, "read_only": true, "tmpfs": ["/tmp:rw,noexec,nosuid,size=128m"], "security_opt": ["no-new-privileges:true"], "cap_drop": ["ALL"], "restart": "no"
    },
    "actor": {
      "image": "vllm/vllm-openai:v0.32.0@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34",
      "profiles": ["gpu"], "gpus": "all", "shm_size": "2g",
      "command": ["--model", "/models/actor", "--served-model-name", "Qwen/Qwen3.5-9B", "--dtype", "bfloat16", "--max-model-len", "32768", "--max-num-seqs", "4", "--gpu-memory-utilization", "0.65", "--language-model-only", "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml", "--reasoning-parser", "qwen3", "--host", "0.0.0.0", "--port", "8000"],
      "ports": ["127.0.0.1:8000:8000"], "volumes": ["${GOALSPEC_MODELS_DIR:-./models}:/models:ro"],
      "environment": {"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1", "VLLM_NO_USAGE_STATS": "1", "DO_NOT_TRACK": "1"},
      "networks": ["research"], "mem_limit": "36g", "cpus": 6, "restart": "no"
    },
    "predictor": {
      "image": "vllm/vllm-openai:v0.32.0@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34",
      "profiles": ["gpu"], "gpus": "all", "shm_size": "1g",
      "command": ["--model", "/models/predictor", "--served-model-name", "Qwen/Qwen3.5-0.8B", "--dtype", "bfloat16", "--max-model-len", "8192", "--max-num-seqs", "1", "--gpu-memory-utilization", "0.20", "--language-model-only", "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_xml", "--reasoning-parser", "qwen3", "--host", "0.0.0.0", "--port", "8000"],
      "ports": ["127.0.0.1:8001:8000"], "volumes": ["${GOALSPEC_MODELS_DIR:-./models}:/models:ro"],
      "environment": {"HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1", "VLLM_NO_USAGE_STATS": "1", "DO_NOT_TRACK": "1"},
      "networks": ["research"], "mem_limit": "8g", "cpus": 2, "restart": "no"
    },
    "prometheus": {
      "image": "${GOALSPEC_PROMETHEUS_IMAGE:-prom/prometheus:v3.15.1}", "profiles": ["cpu", "gpu"],
      "command": ["--config.file=/etc/prometheus/prometheus.json", "--storage.tsdb.path=/prometheus", "--storage.tsdb.retention.time=48h", "--web.enable-remote-write-receiver"],
      "volumes": ["./prometheus.json:/etc/prometheus/prometheus.json:ro", "./alerts.json:/etc/prometheus/alerts.json:ro", "prometheus:/prometheus"],
      "ports": ["127.0.0.1:9090:9090"], "networks": ["research"], "mem_limit": "512m", "cpus": 1, "restart": "no"
    },
    "tempo": {
      "image": "${GOALSPEC_TEMPO_IMAGE:-grafana/tempo:3.1.1}", "profiles": ["cpu", "gpu"],
      "command": ["-config.file=/etc/tempo/tempo.json"],
      "volumes": ["./tempo.json:/etc/tempo/tempo.json:ro", "tempo:/var/tempo"],
      "networks": ["research"], "mem_limit": "512m", "cpus": 1, "restart": "no"
    },
    "loki": {
      "image": "${GOALSPEC_LOKI_IMAGE:-grafana/loki:3.7.9}", "profiles": ["cpu", "gpu"],
      "command": ["-config.file=/etc/loki/loki.json"],
      "volumes": ["./loki.json:/etc/loki/loki.json:ro", "loki:/loki"],
      "networks": ["research"], "mem_limit": "512m", "cpus": 1, "restart": "no"
    },
    "alloy": {
      "image": "${GOALSPEC_ALLOY_IMAGE:-grafana/alloy:v1.21.3}", "profiles": ["cpu", "gpu"],
      "command": ["run", "--server.http.listen-addr=0.0.0.0:12345", "--storage.path=/var/lib/alloy", "/etc/alloy/config.alloy"],
      "volumes": ["./alloy.alloy:/etc/alloy/config.alloy:ro", "alloy:/var/lib/alloy", "${GOALSPEC_ARTIFACTS_DIR:-./artifacts}:/artifacts:ro"],
      "ports": ["127.0.0.1:4317:4317", "127.0.0.1:4318:4318"],
      "networks": ["research"], "mem_limit": "384m", "cpus": 1, "restart": "no"
    },
    "grafana": {
      "image": "${GOALSPEC_GRAFANA_IMAGE:-grafana/grafana:13.3.0}", "profiles": ["cpu", "gpu"],
      "environment": {"GF_SECURITY_ADMIN_PASSWORD__FILE": "/run/secrets/grafana_password", "GF_USERS_ALLOW_SIGN_UP": "false", "GF_AUTH_ANONYMOUS_ENABLED": "false", "GF_ANALYTICS_REPORTING_ENABLED": "false", "GF_ANALYTICS_CHECK_FOR_UPDATES": "false"},
      "secrets": ["grafana_password"],
      "volumes": ["grafana:/var/lib/grafana", "./grafana/provisioning:/etc/grafana/provisioning:ro", "./grafana/dashboards:/var/lib/grafana/dashboards:ro"],
      "ports": ["127.0.0.1:3000:3000"], "networks": ["research"], "mem_limit": "512m", "cpus": 1, "restart": "no"
    }
  },
  "networks": {"research": {"internal": true}, "egress": {}},
  "volumes": {"research-db": {}, "prometheus": {}, "tempo": {}, "loki": {}, "alloy": {}, "grafana": {}},
  "secrets": {"postgres_password": {"file": "${GOALSPEC_POSTGRES_PASSWORD_FILE:?Configure an external research password file}"}, "grafana_password": {"file": "${GOALSPEC_GRAFANA_PASSWORD_FILE:?Configure an external dashboard password file}"}}
}
