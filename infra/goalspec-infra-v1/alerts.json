{"groups":[{"name":"goalspec-integrity","rules":[
  {"alert":"GoalSpecBudgetExhausted","expr":"sum(goalspec_spend_usd) + sum(goalspec_reserved_usd) >= 435","for":"10s","labels":{"severity":"critical"},"annotations":{"summary":"Protected $65 contingency reached; stop new dispatch"}},
  {"alert":"GoalSpecRuntimeUnavailable","expr":"up{job=\"goalspec\"} == 0","for":"1m","labels":{"severity":"warning"},"annotations":{"summary":"Runtime unavailable or runtime profile not started"}},
  {"alert":"GoalSpecInferenceQueueGrowing","expr":"vllm:num_requests_waiting > 8","for":"1m","labels":{"severity":"warning"},"annotations":{"summary":"Inference queue exceeds initial workload bounds"}}
]}]}
