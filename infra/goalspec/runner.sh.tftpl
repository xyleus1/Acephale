#!/bin/bash
set -euo pipefail
umask 077
# AMI must already contain awscli, Docker, Node and the locked Python environment.
# No credentials are embedded in user data or the runner release.
shutdown -h +${lifetime_minutes}
mkdir -p /opt/goalspec /var/lib/goalspec/artifacts
cd /opt/goalspec
aws s3 cp 's3://${release_bucket}/${release_key}' release.tar.gz --region us-east-2
echo '${release_sha256}  release.tar.gz' | sha256sum --check --strict
tar -xzf release.tar.gz --no-same-owner
# This command must perform credential, snapshot, pricing and reservation preflight.
# A failed run still exports its events and budget terminations.
set +e
./run-research.sh /var/lib/goalspec/artifacts
run_status=$?
set -e
echo "$run_status" > /var/lib/goalspec/artifacts/exit-status
tar -czf /opt/goalspec/results.tar.gz -C /var/lib/goalspec artifacts
aws s3 cp /opt/goalspec/results.tar.gz 's3://${artifact_bucket}/results.tar.gz' --checksum-algorithm SHA256 --region us-east-2
aws s3 cp 's3://${artifact_bucket}/results.tar.gz' /opt/goalspec/export-verification.tar.gz --region us-east-2
cmp /opt/goalspec/results.tar.gz /opt/goalspec/export-verification.tar.gz
# Only verified export licenses deletion of the instance and its research volume.
token=$(curl -fsS -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)
instance=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
aws ec2 terminate-instances --instance-ids "$instance" --region us-east-2
