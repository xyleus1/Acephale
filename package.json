{
  "name": "acephale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Goal-conditioned PASTE with workflow memory, matched controls and reproducible agent evaluation.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "check": "npm run acephale:check",
    "test": "node --import tsx --test --test-concurrency=1 scripts/acephale-*.test.ts",
    "lint": "eslint src services scripts",
    "acephale:generate": "node --import tsx scripts/acephale-generate.ts && node --import tsx scripts/acephale-infra-generate.ts",
    "acephale:check": "node --import tsx scripts/acephale-generate.ts --check && node --import tsx scripts/acephale-infra-generate.ts --check && tsc --project tsconfig.json --noEmit",
    "acephale:infra": "node --import tsx scripts/acephale-infra-run.ts",
    "acephale:infra-native": "node --import tsx scripts/acephale-infra-native.ts",
    "acephale:infra-predict": "node --import tsx scripts/acephale-infra-predict.ts",
    "acephale:infra-annotate": "node --import tsx scripts/acephale-infra-annotate.ts",
    "acephale:embeddings": "node --import tsx scripts/acephale-infra-embeddings.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@prometheus-io/client": "0.16.1",
    "ajv": "8.17.1",
    "js-tiktoken": "1.0.21",
    "openai": "6.34.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "eslint": "9.39.4",
    "@typescript-eslint/parser": "8.57.2",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1"
  }
}
