generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  EMPLOYEE // loadboard-only operator: sees loads/pipeline, nothing else
}

enum CustomerStatus {
  UNTOUCHED
  IN_PROGRESS
  WORKED
  LOST
}

enum ActivityType {
  NOTE
  VISIT
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SLACK
  RFQ
  QUOTE
  WEB_INTEL
  TASK
  AGENT_SUGGESTION
}

enum QuoteResult {
  PENDING
  WON
  LOST
}

enum CategoryType {
  CLASS1
  CLASS2
  PRODUCT
  LANE
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  PROPOSED
  INQUIRY
  QUOTED
  BOOKED
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  CANCELLED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model Office {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  companies            Company[]
  activities           Activity[]
  quotes               Quote[]
  shipments            ShipmentRecord[]
  documents            CompanyDocument[]
  laneRates            LaneRate[]
  marginProfiles       MarginProfile[]
  inquiries            Inquiry[]
  jobs                 Job[]
  jobDocuments         JobDocument[]
  emailAccounts        EmailAccount[]
  emailThreads         EmailThread[]
  assignmentChanges    AssignmentChange[]
  events               Event[]
  categories           CategoryOption[]
  tasks                Task[]
  crmOpportunities     CrmOpportunity[]
  riskAlerts           RiskAlert[]
  savedViews           SavedView[]
  targetPriceHistory   TargetPriceHistory[]
  agentProposals       AgentProposal[]
  forwarders           Forwarder[]
  forwarderDrafts      ForwarderRequestDraft[]
  carriers             Carrier[]
  carrierChecklist     CarrierChecklistItem[]
  loadSecurityChecks   LoadSecurityCheck[]
  carrierBids          CarrierBid[]
  truckloadQuotes      TruckloadQuote[]
  strategyAssessments  StrategyAssessment[]
  routeOptions         RouteOption[]
  priceRecommendations PriceRecommendation[]
  riskAssessments      RiskAssessment[]
  strategyActions      StrategyAction[]
  backgroundJobs       BackgroundJob[]
  knowledgeSources     KnowledgeSource[]
  knowledgeObjects     KnowledgeObject[]
  knowledgeChunks      KnowledgeChunk[]
  entityMentions       EntityMention[]
  memoryEvents         MemoryEvent[]
  agentMemories        AgentMemory[]
  marketSignals        MarketSignal[]
  marketSignalLinks    MarketSignalLink[]
  marketImpactReviews  MarketImpactReview[]
  marketSignalFeedback MarketSignalFeedback[]
  marketIngestionRuns  MarketIngestionRun[]
  auditLogs            AuditLog[]

  @@unique([name])
}

model SavedView {
  id        String   @id @default(cuid())
  officeId  String
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, userId, name])
  @@index([officeId, userId, createdAt])
}

model CategoryOption {
  id        String       @id @default(cuid())
  officeId  String
  type      CategoryType
  value     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, type, value])
  @@index([officeId, type, isActive])
}

model User {
  id                 String   @id @default(cuid())
  officeId           String
  email              String
  passwordHash       String
  fullName           String
  role               UserRole @default(SALES)
  isActive           Boolean  @default(true)
  canViewWholeOffice Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  ownedCompanies        CompanyOwner[]
  activitiesCreated     Activity[]         @relation("ActivityCreatedBy")
  assignmentChangesMade AssignmentChange[] @relation("AssignmentChangedBy")
  assignedJobs          Job[]              @relation("JobAssignee")
  assignedInquiries     Inquiry[]          @relation("InquiryAssignee")

  @@unique([officeId, email])
  @@index([officeId, role])
}

model Company {
  id       String         @id @default(cuid())
  officeId String
  name     String
  status   CustomerStatus @default(UNTOUCHED)

  // Category values (one per category for MVP)
  class1    String? // Passive / Potential / Active
  class2    String? // A-E
  product   String? // Sea / Air / Road / LTL / Project (MVP: single)
  lane      String? // Region e.g., "Mediterranean", "America", "Europe"
  direction String? // Import / Export / Both

  // Internal Relationship OS metadata. Existing Company remains the account
  // source of truth; these fields make it usable for customers, prospects,
  // vendors, investors, advisors, and strategic partners.
  domain               String?
  website              String?
  linkedinUrl          String?
  crmCategory          String    @default("customer")
  crmStage             String    @default("new")
  crmPriority          String    @default("medium")
  relationshipStrength String    @default("unknown")
  crmSource            String    @default("manual")
  sourceRefs           Json?
  brainSlug            String?
  crmTags              Json?
  crmNotes             String?
  lastTouchAt          DateTime?
  nextActionAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  contacts          Contact[]
  owners            CompanyOwner[]
  activities        Activity[]
  quotes            Quote[]
  shipments         ShipmentRecord[]
  documents         CompanyDocument[]
  assignmentChanges AssignmentChange[]
  tasks             Task[]
  crmOpportunities  CrmOpportunity[]
  riskAlerts        RiskAlert[]
  jobs              Job[]
  inquiries         Inquiry[]
  emailThreads      EmailThread[]
  carriers          Carrier[]
  truckloadQuotes   TruckloadQuote[]

  @@unique([officeId, name])
  @@index([officeId, status])
  @@index([officeId, crmCategory])
  @@index([officeId, crmStage])
  @@index([officeId, crmPriority])
  @@index([officeId, nextActionAt])
  @@index([officeId, class1])
  @@index([officeId, class2])
  @@index([officeId, product])
  @@index([officeId, lane])
}

model Contact {
  id                 String    @id @default(cuid())
  companyId          String
  fullName           String
  title              String?
  email              String?
  phone              String?
  notes              String?
  isApprovedForInbox Boolean   @default(false)
  approvedForInboxAt DateTime?
  linkedinUrl        String?
  location           String?
  relationshipType   String    @default("buyer")
  leverageLevel      String    @default("medium")
  relationshipStrength String  @default("unknown")
  category           String? // customer / potential_customer / logistics_contact / high_value / other
  status             String? // not_contacted / contacted / in_talks / active / cold
  ownerLabel         String?
  sourceRefs         Json?
  brainSlug          String?
  tags               Json?
  lastTouchAt        DateTime?
  nextActionAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities       Activity[]
  tasks            Task[]
  crmOpportunities CrmOpportunity[]
  emailThreads     EmailThread[]

  @@index([companyId])
  @@index([companyId, isApprovedForInbox])
  @@index([companyId, relationshipType])
  @@index([companyId, leverageLevel])
  @@index([companyId, nextActionAt])
  @@index([category])
}

// Multiple owners per company (requested)
model CompanyOwner {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Activity {
  id         String       @id @default(cuid())
  officeId   String
  companyId  String
  contactId  String?
  inquiryId  String?
  opportunityId String?
  type       ActivityType
  occurredAt DateTime     @default(now())

  subject  String?
  body     String?
  audioUrl String?
  source   String?
  sourceRefs Json?
  provenance Json?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  office      Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiry     Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([officeId, companyId, occurredAt])
  @@index([officeId, contactId, occurredAt])
  @@index([officeId, opportunityId, occurredAt])
  @@index([officeId, inquiryId, occurredAt])
  @@index([officeId, type, occurredAt])
}

model Quote {
  id          String      @id @default(cuid())
  officeId    String
  companyId   String
  result      QuoteResult @default(PENDING)
  origin      String? // e.g. Istanbul, TR
  destination String? // e.g. Hamburg, DE
  mode        String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  value       Float?
  currency    String? // e.g. USD, EUR, TRY
  notes       String?
  lostReason  String? // Price / Competitor / No volume / Wrong lane / Other
  quotedAt    DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, companyId, quotedAt])
  @@index([officeId, result, quotedAt])
}

// Assignment changes log (audit trail)
model AssignmentChange {
  id              String   @id @default(cuid())
  officeId        String
  companyId       String
  changedByUserId String?
  createdAt       DateTime @default(now())

  // JSON snapshot for MVP simplicity (who added/removed; primary changes, etc.)
  diff Json

  office    Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("AssignmentChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([officeId, companyId, createdAt])
}

// Who changed what, where - the admin-facing activity log. One row per user
// action on a load (status change, claim, assignment, field edit, creation).
// actorEmail is denormalized so the log stays readable even if a user row
// is deactivated or removed.
model AuditLog {
  id          String  @id @default(cuid())
  officeId    String
  actorUserId String?
  actorEmail  String
  action      String // load.status_changed | load.claimed | load.assigned | load.updated | load.created
  entityType  String  @default("job")
  entityId    String?
  entityRef   String? // human ref for display, e.g. JOB-2025-001
  summary     String // one-line human-readable description
  changes     Json? // [{ field, from, to }]

  createdAt DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, createdAt])
  @@index([officeId, entityType, entityId, createdAt])
  @@index([officeId, actorUserId, createdAt])
}

// Generic event table for future risk signals / phase2 integrations
model Event {
  id         String   @id @default(cuid())
  officeId   String
  type       String
  entityType String?
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, type, createdAt])
  @@index([officeId, entityType, entityId])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  officeId    String
  type        String
  status      String    @default("QUEUED") // QUEUED / RUNNING / DONE / FAILED
  payload     Json
  dedupeKey   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, status, runAfter])
  @@index([officeId, type, status])
  @@index([dedupeKey, status])
}

// Canonical company-brain source registry. This is intentionally generic:
// Gmail, WhatsApp, Sheets, CRM rows, documents, strategy snapshots, and agent
// outputs can all become memory without rewriting the current product flows.
model KnowledgeSource {
  id          String   @id @default(cuid())
  officeId    String
  type        String
  label       String?
  externalId  String?
  status      String   @default("ACTIVE")
  trustLevel  String   @default("INTERNAL")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  objects       KnowledgeObject[]
  events        MemoryEvent[]
  agentMemories AgentMemory[]

  @@unique([officeId, type, externalId])
  @@index([officeId, type, status])
}

model KnowledgeObject {
  id                   String   @id @default(cuid())
  officeId             String
  sourceId             String?
  sourceType           String
  sourceExternalId     String
  canonicalType        String
  title                String?
  contentHash          String?
  rawRef               String?
  visibility           String   @default("INTERNAL")
  retentionPolicy      String   @default("DEFAULT")
  entityType           String?
  entityId             String?
  companyId            String?
  contactId            String?
  inquiryId            String?
  jobId                String?
  emailThreadId        String?
  emailMessageId       String?
  jobDocumentId        String?
  strategyAssessmentId String?
  agentProposalId      String?
  occurredAt           DateTime
  ingestedAt           DateTime @default(now())
  payloadVersion       Int      @default(1)
  payload              Json
  provenance           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source        KnowledgeSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  chunks        KnowledgeChunk[]
  mentions      EntityMention[]
  events        MemoryEvent[]
  agentMemories AgentMemory[]
  marketSignals MarketSignal[]

  @@unique([officeId, sourceType, sourceExternalId])
  @@index([officeId, canonicalType, occurredAt])
  @@index([officeId, entityType, entityId])
  @@index([officeId, companyId, occurredAt])
  @@index([officeId, jobId, occurredAt])
  @@index([officeId, inquiryId, occurredAt])
  @@index([officeId, emailThreadId])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  officeId       String
  objectId       String
  ordinal        Int      @default(0)
  kind           String   @default("TEXT")
  text           String
  tokenCount     Int?
  sourceSpan     Json?
  metadata       Json?
  payloadVersion Int      @default(1)
  provenance     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  office   Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  object   KnowledgeObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  mentions EntityMention[]

  @@unique([objectId, ordinal])
  @@index([officeId, objectId])
}

model EntityMention {
  id             String   @id @default(cuid())
  officeId       String
  objectId       String?
  chunkId        String?
  entityType     String
  entityId       String
  label          String?
  confidence     Float?
  source         String   @default("SYSTEM")
  metadata       Json?
  payloadVersion Int      @default(1)
  provenance     Json
  createdAt      DateTime @default(now())

  office Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  object KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)
  chunk  KnowledgeChunk?  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([officeId, entityType, entityId])
  @@index([officeId, objectId])
  @@index([officeId, chunkId])
}

model MemoryEvent {
  id               String   @id @default(cuid())
  officeId         String
  sourceId         String?
  objectId         String?
  sourceType       String
  sourceExternalId String?
  eventType        String
  entityType       String
  entityId         String
  actorType        String?
  actorId          String?
  occurredAt       DateTime
  ingestedAt       DateTime @default(now())
  idempotencyKey   String?
  payloadVersion   Int      @default(1)
  payload          Json
  provenance       Json
  createdAt        DateTime @default(now())

  office        Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source        KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  object        KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  agentMemories AgentMemory[]

  @@unique([officeId, idempotencyKey])
  @@index([officeId, eventType, occurredAt])
  @@index([officeId, entityType, entityId, occurredAt])
  @@index([officeId, sourceType, sourceExternalId])
}

model AgentMemory {
  id             String    @id @default(cuid())
  officeId       String
  sourceId       String?
  objectId       String?
  eventId        String?
  agentName      String
  memoryType     String
  subjectType    String?
  subjectId      String?
  companyId      String?
  jobId          String?
  inquiryId      String?
  content        String
  status         String    @default("ACTIVE")
  confidence     Float?
  payloadVersion Int       @default(1)
  payload        Json?
  provenance     Json
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  office Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  object KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  event  MemoryEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([officeId, agentName, status])
  @@index([officeId, memoryType, status])
  @@index([officeId, subjectType, subjectId])
  @@index([officeId, companyId])
  @@index([officeId, jobId])
  @@index([officeId, inquiryId])
}

model MarketSignal {
  id                   String   @id @default(cuid())
  officeId             String
  sourceObjectId       String?
  category             String
  severity             String
  confidence           Float
  affectedModes        Json
  affectedOrigins      Json
  affectedDestinations Json
  affectedPorts        Json
  affectedLanes        Json
  affectedCarriers     Json
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  summary              String
  operatorImplication  String?
  pricingImplication   String?
  customerImpact       String?
  recommendedActions   Json
  sourceRefs           Json
  dedupeKey            String
  payloadVersion       Int      @default(1)
  provenance           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  office       Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  sourceObject KnowledgeObject?    @relation(fields: [sourceObjectId], references: [id], onDelete: SetNull)
  links        MarketSignalLink[]
  impactReviews MarketImpactReview[]
  feedback     MarketSignalFeedback[]

  @@unique([officeId, dedupeKey])
  @@index([officeId, category, severity, createdAt])
  @@index([officeId, effectiveFrom, effectiveTo])
  @@index([officeId, sourceObjectId])
}

model MarketSignalLink {
  id         String   @id @default(cuid())
  officeId   String
  signalId   String
  entityType String
  entityId   String
  matchType  String
  confidence Float
  reason     String?
  createdAt  DateTime @default(now())

  office Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  signal MarketSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  impactReviews MarketImpactReview[]

  @@unique([signalId, entityType, entityId])
  @@index([officeId, entityType, entityId])
  @@index([officeId, signalId])
}

model MarketImpactReview {
  id                 String   @id @default(cuid())
  officeId           String
  marketSignalId     String
  marketSignalLinkId String?
  linkedEntityType   String
  linkedEntityId     String
  impactLevel        String
  impactReason       String
  recommendedAction  String?
  status             String   @default("pending")
  feedbackKind       String?
  feedbackNote       String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  actionedAt         DateTime?
  sourceRefs         Json
  payloadVersion     Int      @default(1)
  provenance         Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  office           Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  marketSignal     MarketSignal        @relation(fields: [marketSignalId], references: [id], onDelete: Cascade)
  marketSignalLink MarketSignalLink?   @relation(fields: [marketSignalLinkId], references: [id], onDelete: SetNull)
  feedback         MarketSignalFeedback[]

  @@unique([officeId, marketSignalId, linkedEntityType, linkedEntityId])
  @@index([officeId, status])
  @@index([marketSignalId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([createdAt])
}

model MarketSignalFeedback {
  id                   String   @id @default(cuid())
  officeId             String
  marketSignalId       String
  marketImpactReviewId String?
  userId               String?
  feedbackKind         String
  note                 String?
  createdAt            DateTime @default(now())

  office             Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  marketSignal       MarketSignal        @relation(fields: [marketSignalId], references: [id], onDelete: Cascade)
  marketImpactReview MarketImpactReview? @relation(fields: [marketImpactReviewId], references: [id], onDelete: SetNull)

  @@index([officeId, feedbackKind, createdAt])
  @@index([marketSignalId])
  @@index([marketImpactReviewId])
}

model MarketIngestionRun {
  id          String    @id @default(cuid())
  officeId    String
  provider    String
  sourceId    String?
  query       String?
  status      String    @default("queued")
  startedAt   DateTime?
  completedAt DateTime?
  resultCount Int       @default(0)
  objectCount Int       @default(0)
  signalCount Int       @default(0)
  reviewCount Int       @default(0)
  error       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, provider, status])
  @@index([officeId, sourceId, createdAt])
  @@index([officeId, status, createdAt])
}

model Task {
  id               String     @id @default(cuid())
  officeId         String
  companyId        String
  contactId        String?
  inquiryId        String?
  opportunityId    String?
  title            String
  details          String?
  dueAt            DateTime?
  status           TaskStatus @default(OPEN)
  priority         String     @default("medium")
  source           String?
  sourceRefs       Json?
  provenance       Json?
  assignedToUserId String?
  createdByUserId  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  office      Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiry     Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([officeId, status, dueAt])
  @@index([officeId, priority, dueAt])
  @@index([officeId, contactId, status])
  @@index([officeId, opportunityId, status])
  @@index([officeId, inquiryId, status])
  @@index([companyId, status])
}

model CrmOpportunity {
  id              String   @id @default(cuid())
  officeId        String
  companyId       String
  contactId       String?
  inquiryId       String?
  name            String
  type            String   @default("customer_lead")
  stage           String   @default("idea")
  estimatedValue  Float?
  currency        String?  @default("USD")
  likelihood      Int?
  priority        String   @default("medium")
  nextAction      String?
  nextActionAt    DateTime?
  source          String   @default("manual")
  sourceRefs      Json?
  brainSlug       String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  office     Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiry    Inquiry?   @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks      Task[]

  @@index([officeId, stage, priority])
  @@index([officeId, type, stage])
  @@index([officeId, nextActionAt])
  @@index([officeId, companyId])
  @@index([officeId, contactId])
  @@index([officeId, inquiryId])
}

model RiskAlert {
  id         String    @id @default(cuid())
  officeId   String
  companyId  String
  level      RiskLevel
  reason     String
  isOpen     Boolean   @default(true)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, isOpen, level, createdAt])
  @@index([companyId, isOpen])
}

model CompanyDocument {
  id               String   @id @default(cuid())
  officeId         String
  companyId        String
  name             String
  url              String
  docType          String? // contract / invoice / proposal / other
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, companyId, createdAt])
}

// ── Pricing module ────────────────────────────────────────────────────────

model LaneRate {
  id          String    @id @default(cuid())
  officeId    String
  origin      String // e.g. Istanbul
  destination String // e.g. Hamburg
  mode        String // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  baseAmount  Float
  currency    String    @default("USD")
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, origin, destination, mode])
}

model MarginProfile {
  id            String   @id @default(cuid())
  officeId      String
  label         String // e.g. "New client", "Existing – standard", "Urgent"
  customerTier  String? // new / existing / vip
  urgency       String? // normal / asap / flexible
  marginPercent Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId])
}

// Cache of computed summaries per Inquiry. Avoids re-running the extraction
// + sort + JSON shaping on every agent query. Keyed by inquiryId, with kind
// distinguishing different summary shapes (e.g. supplier-shortlist).
model Inquiry {
  id                String    @id @default(cuid())
  officeId          String
  companyId         String?
  reference         String? // freight file number, e.g. DRY26070001 - assigned at intake, carried onto the converted load
  subject           String
  fromEmail         String?
  fromCompany       String?
  origin            String?
  destination       String?
  mode              String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  containerCount    Int?
  containerType     String? // 20GP / 40HC / 40DRY / 20DRY etc.
  packages          Int?
  dimensions        String? // JSON [{qty, length, width, height}] in cm
  stackable         String? // YES / NO / UNKNOWN
  topLoad           String? // YES / NO / UNKNOWN, only relevant when stackable=NO
  dangerousGoods    String? // YES / NO / UNKNOWN
  customsBy         String? // US / CUSTOMER / FORWARDER / UNKNOWN
  commodity         String?
  weight            Float?
  volume            Float?
  incoterms         String?
  targetPrice       Float?
  targetCurrency    String?
  targetPriceStatus String? // UNKNOWN / PROVIDED / NO_TARGET
  targetPriceSource String?
  cargoReadyDate    DateTime?
  // High-value tech-freight fields (vocab in src/lib/security-sop.ts)
  declaredValue         Float?
  declaredValueCurrency String?
  securityTier          String? // standard / elevated / high_value / critical
  commodityCategory     String? // tech commodity taxonomy, e.g. servers_gpu
  trackingType          String? // none / phone_check / eld_app / gps_device / escort
  equipmentType         String? // DRY_VAN / REEFER / FLATBED / … - first-class truck equipment
  teamDriversRequired   String? // YES / NO / UNKNOWN
  type              String    @default("FORWARDING") // FORWARDING (move customer's cargo) | SOURCING (find + buy a commodity for customer)
  status            String    @default("INGESTED") // INGESTED / PARSED / PRICED / QUOTED / WON / LOST
  // RFQ desk workflow (2026-07-24): who owns the RFQ + operator-entered truth
  // that survives lead resyncs (resync never writes these columns).
  assignedToUserId  String?
  contactName       String?
  contactPhone      String?
  manualDetails     String? // real details pasted from WhatsApp - the truth when form answers are noise
  forwardedTo       String? // JSON string[] of partner forwarders this RFQ went to (see src/lib/forwarder-partners.ts)
  rawEmailBody      String?
  parsedData        String? // JSON: AI-extracted fields
  notes             String?
  // Pre-computed summary cache (JSON). Used by the agent's
  // summarize_supplier_offers tool to skip re-parsing + ranking on every
  // query. Cleared whenever a linked thread is added/updated/awarded so
  // the next read regenerates.
  summaryCache      String?
  summaryCacheAt    DateTime?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office              Office                  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company             Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo          User?                   @relation("InquiryAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  carrierQuotes       CarrierQuote[]
  job                 Job?
  emailThreads        EmailThread[]
  targetPriceHistory  TargetPriceHistory[]
  agentProposals      AgentProposal[]
  forwarderDrafts     ForwarderRequestDraft[]
  strategyAssessments StrategyAssessment[]
  crmOpportunities    CrmOpportunity[]
  activities          Activity[]
  tasks               Task[]
  carrierBids         CarrierBid[]
  truckloadQuotes     TruckloadQuote[]

  @@unique([officeId, reference])
  @@index([officeId, status, receivedAt])
  @@index([officeId, companyId])
  @@index([officeId, assignedToUserId])
}

model TargetPriceHistory {
  id              String   @id @default(cuid())
  officeId        String
  inquiryId       String?
  jobId           String?
  amount          Float?
  currency        String?
  status          String   @default("UNKNOWN") // PROVIDED / NO_TARGET / UNKNOWN
  source          String?
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([officeId, inquiryId, createdAt])
  @@index([officeId, jobId, createdAt])
}

model CarrierQuote {
  id             String   @id @default(cuid())
  inquiryId      String
  carrier        String
  quoteType      String   @default("EMAIL") // API / EMAIL
  rateName       String?
  total20        Float?
  total40        Float?
  total40HC      Float?
  transitDays    Int?
  service        String?
  validity       String?
  transshipments String?
  status         String   @default("PENDING") // PENDING / RECEIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model Forwarder {
  id           String   @id @default(cuid())
  officeId     String
  name         String
  email        String
  modeCoverage String? // comma-separated modes, blank means all modes
  apiType      String   @default("EMAIL") // EMAIL / API
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office        Office                  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  requestDrafts ForwarderRequestDraft[]

  @@unique([officeId, email])
  @@index([officeId, active])
}

model ForwarderRequestDraft {
  id              String    @id @default(cuid())
  officeId        String
  inquiryId       String
  forwarderId     String?
  forwarderName   String
  toEmail         String
  subject         String
  body            String
  status          String    @default("DRAFT") // DRAFT / DISCARDED / SENT
  createdByUserId String?
  senderAccountId String?
  sentByEmail     String?
  sentAt          DateTime?
  gmailMessageId  String?
  gmailThreadId   String?
  sendError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry   Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  forwarder Forwarder? @relation(fields: [forwarderId], references: [id], onDelete: SetNull)

  @@index([officeId, inquiryId, status])
  @@index([officeId, forwarderId])
}

// Per-load security SOP checklist, seeded from the load's securityTier
// (template + tier logic in src/lib/security-sop.ts). The checklist is the
// operator-facing half of the trust artifact; a customer-safe rendering
// lands on the portal later.
model LoadSecurityCheck {
  id                String    @id @default(cuid())
  officeId          String
  jobId             String
  key               String // securityChecklistTemplate key
  label             String
  status            String    @default("pending") // pending / done / na / flagged
  note              String?
  completedByUserId String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
  @@index([officeId, jobId, status])
}

// The vetted trucking-carrier bench for US domestic (CA tech-freight niche).
// Operational entity, deliberately separate from Forwarder (intl supplier
// directory) and from CRM Company (relationship layer; optional link only).
// Vocabulary lives in src/lib/carrier-vetting.ts.
model Carrier {
  id        String  @id @default(cuid())
  officeId  String
  companyId String? // optional link to a CRM Company; never auto-created
  name      String
  legalName String?
  mcNumber  String? // FMCSA MC number
  dotNumber String? // USDOT number
  scac      String?

  // Contact + deceptive-pickup (carrier impersonation) defense
  dispatchEmail        String?
  dispatchPhone        String?
  verifiedPhone        String? // callback number verified against FMCSA/insurance producer records
  emailDomain          String? // expected corporate mail domain (freemail dispatch = flag)
  emailDomainVerified  Boolean   @default(false)
  factoringCompany     String?
  authorityFirstActive DateTime? // young authority is a fraud signal
  fraudFlags           Json? // [{flag, note, at, byUserId}]
  identityVerifiedAt   DateTime?
  identityVerifiedBy   String?

  // Authority + insurance (manual V1 - no FMCSA/RMIS API)
  authorityStatus        String? // active / inactive / revoked / unknown
  insuranceProducer      String? // agency the COI was verified with, direct
  autoLiabilityLimit     Float?
  cargoLimit             Float?
  autoInsuranceExpiry    DateTime?
  cargoInsuranceExpiry   DateTime?
  coiUrl                 String?
  highValueApprovedLimit Float? // max declared value we give them without a special rider

  // Equipment + capability
  equipmentTypes   Json? // ["DRY_VAN","REEFER",...] - DomesticEquipmentType strings
  airRide          Boolean @default(false)
  liftgate         Boolean @default(false)
  blanketWrap      Boolean @default(false)
  teamDrivers      Boolean @default(false)
  hazmatCertified  Boolean @default(false)
  lithiumCapable   Boolean @default(false) // UN3480/3481 experience
  reeferCapable    Boolean @default(false)
  securityFeatures Json? // ["high_security_locks","covert_gps","geofencing",...]
  serviceStates    Json? // ["CA","NV","AZ",...]
  homeBase         String? // e.g. "Fremont, CA"

  // Vetting workflow - gate logic in carrierVettingGate()
  vettingStatus  String    @default("prospect")
  vettingNotes   String?
  vettedAt       DateTime?
  vettedByUserId String?
  nextReviewAt   DateTime? // driven by the nearest insurance expiry

  // Scorecard - columns reserved now, auto-computed from load history later
  loadsCompleted    Int       @default(0)
  onTimePickupPct   Float?
  onTimeDeliveryPct Float?
  claimCount        Int       @default(0)
  incidentCount     Int       @default(0)
  scorecardScore    Float?
  scorecardAt       DateTime?

  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office    Office                 @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company   Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  checklist CarrierChecklistItem[]
  bids      CarrierBid[]

  @@unique([officeId, mcNumber])
  @@unique([officeId, dotNumber])
  @@index([officeId, vettingStatus, active])
  @@index([officeId, name])
  @@index([officeId, cargoInsuranceExpiry])
}

// One row per vetting-checklist item per carrier; template + gate logic in
// src/lib/carrier-vetting.ts. Evidence is a paste-URL in V1.
model CarrierChecklistItem {
  id              String    @id @default(cuid())
  officeId        String
  carrierId       String
  key             String // CARRIER_VETTING_CHECKLIST key
  label           String
  status          String    @default("pending") // pending / passed / failed / waived
  note            String?
  evidenceUrl     String?
  checkedByUserId String?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([carrierId, key])
  @@index([officeId, carrierId, status])
}

// Truckload buy-side quote from a carrier (per-load $, not ocean totals -
// CarrierQuote stays ocean-shaped for the intl stack). Bids link to the
// vetted bench when the carrier is onboarded; carrierName covers the rest.
model CarrierBid {
  id            String    @id @default(cuid())
  officeId      String
  inquiryId     String?
  jobId         String?
  carrierId     String?
  carrierName   String
  equipmentType String? // DRY_VAN / REEFER / … (pricing-engine strings)
  linehaulAmount    Float?
  fscAmount         Float? // fuel surcharge
  accessorialAmount Float?
  totalAmount       Float? // all-in per-load buy
  currency      String    @default("USD")
  miles         Float?
  ratePerMile   Float? // stored, not derived - operator-entered all-in rates survive
  transitDays   Int?
  validUntil    DateTime?
  source        String    @default("MANUAL") // MANUAL / EMAIL / WHATSAPP / PHONE / LOADBOARD / API
  status        String    @default("RECEIVED") // REQUESTED / RECEIVED / DECLINED / SELECTED / EXPIRED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([officeId, inquiryId])
  @@index([officeId, jobId])
  @@index([officeId, carrierId, createdAt])
}

// Sell-side truckload quote + outcome - one row per issued quote version.
// This is the data flywheel: normalized lane x equipment x tier with buy/sell
// economics, quote speed, and win/loss. Vocab in src/lib/truckload-quote-fields.ts.
model TruckloadQuote {
  id        String  @id @default(cuid())
  officeId  String
  inquiryId String?
  jobId     String?
  companyId String?

  // Normalized lane - corridor keys for aggregation
  origin            String?
  destination       String?
  originState       String? // classifyDomesticLocation().stateCode
  destState         String?
  miles             Float?
  mode              String? // FTL / LTL / PARTIAL / DRAYAGE
  equipmentType     String?
  commodityCategory String?
  securityTier      String?
  declaredValue     Float?

  // Economics
  buyAmount    Float?
  buySource    String? // mock / manual / carrier_bid / live:<provider>
  carrierBidId String?
  carrierId    String? // winning/selected carrier once known
  sellAmount   Float?
  currency     String  @default("USD")
  marginPct    Float?
  grossProfit  Float?
  ratePerMile  Float?

  // Quote speed + outcome
  sentVia       String? // EMAIL / WHATSAPP / PORTAL / NONE
  sentAt        DateTime?
  rfqReceivedAt DateTime? // copied from inquiry.receivedAt - quote-speed KPI
  outcome       String    @default("PENDING") // PENDING / WON / LOST / EXPIRED / NO_QUOTE
  outcomeReason String? // price_too_high / no_capacity / too_slow / …
  outcomeNote   String?
  outcomeAt     DateTime?
  decidedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([officeId, outcome, createdAt])
  @@index([officeId, originState, destState, equipmentType])
  @@index([officeId, inquiryId])
  @@index([officeId, companyId, createdAt])
}

// Shipment history - populated from Siber in Phase 2, or manually entered
model ShipmentRecord {
  id           String   @id @default(cuid())
  officeId     String
  companyId    String
  origin       String?
  destination  String?
  mode         String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  weight       Float? // kg
  volume       Float? // cbm
  revenue      Float?
  profit       Float?
  currency     String?  @default("USD")
  shipmentDate DateTime
  reference    String? // Siber / carrier reference number
  source       String   @default("manual") // "siber" | "manual"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, companyId, shipmentDate])
  @@index([officeId, shipmentDate])
}

// ── Jobs (forwarding operations) ─────────────────────────────────────────────

model Job {
  id               String  @id @default(cuid())
  officeId         String
  companyId        String?
  assignedToUserId String?
  inquiryId        String? @unique // set when converted from an Inquiry

  reference         String // e.g. JOB-2025-001
  title             String? // human deal name, e.g. "China Spare Parts" - how the user recalls the load
  cadence           String? // ONE_OFF | MONTHLY - recurring business vs one-shot
  status            JobStatus @default(INQUIRY)
  type              String    @default("FORWARDING") // FORWARDING | SOURCING
  mode              String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  origin            String?
  destination       String?
  commodity         String?
  incoterms         String?
  weight            Float? // kg
  volume            Float? // cbm - auto-computed from dimensions for non-FCL
  packages          Int?
  dimensions        String? // JSON [{qty, length, width, height}] in cm - LCL/AIR/ROAD cargo
  stackable         String? // YES / NO / UNKNOWN
  topLoad           String? // YES / NO / UNKNOWN, only relevant when stackable=NO
  dangerousGoods    String? // YES / NO / UNKNOWN
  customsBy         String? // US / CUSTOMER / FORWARDER / UNKNOWN
  containerCount    Int? // FCL: number of containers
  containerType     String? // FCL: 20DC / 40DC / 40HC / 20RF / 40RF / OT-FR
  quantity          Float? // generic deal quantity, e.g. 350 (TONS), 3 (TRUCKS)
  quantityUnit      String? // TONS / TRUCKS / PALLETS / UNITS / KG / CBM - free text
  targetPrice       Float?
  targetCurrency    String?
  targetPriceStatus String? // UNKNOWN / PROVIDED / NO_TARGET
  targetPriceSource String?
  quoteLines        String? // pipe-delimited quote line items (desc|amount|currency per line)
  // High-value tech-freight fields (vocab in src/lib/security-sop.ts)
  declaredValue         Float?
  declaredValueCurrency String?
  securityTier          String? // standard / elevated / high_value / critical
  commodityCategory     String? // tech commodity taxonomy, e.g. servers_gpu
  trackingType          String? // none / phone_check / eld_app / gps_device / escort
  equipmentType         String? // DRY_VAN / REEFER / FLATBED / … - first-class truck equipment
  teamDriversRequired   String? // YES / NO / UNKNOWN

  etd DateTime?
  eta DateTime?

  revenue  Float?
  cost     Float?
  currency String @default("USD")

  notes          String?
  portalToken    String?  @unique // public magic-link token for /portal/[token]
  notifyCustomer Boolean  @default(true) // auto-email customer on status/milestone changes
  customerEmail  String? // override for status-update emails; defaults to inquiry.fromEmail
  parentJobId    String? // when a SOURCING award spins up a child FORWARDING job
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  office              Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  inquiry             Inquiry?             @relation(fields: [inquiryId], references: [id])
  assignedTo          User?                @relation("JobAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parent              Job?                 @relation("JobParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  children            Job[]                @relation("JobParent")
  documents           JobDocument[]
  milestones          JobMilestone[]
  emailThreads        EmailThread[]
  targetPriceHistory  TargetPriceHistory[]
  agentProposals      AgentProposal[]
  strategyAssessments StrategyAssessment[]
  securityChecks      LoadSecurityCheck[]
  carrierBids         CarrierBid[]
  truckloadQuotes     TruckloadQuote[]

  @@unique([officeId, reference])
  @@index([officeId, status, createdAt])
  @@index([officeId, companyId])
  @@index([officeId, assignedToUserId])
}

model AgentProposal {
  id               String    @id @default(cuid())
  officeId         String
  userId           String?
  jobId            String?
  inquiryId        String?
  kind             String
  status           String    @default("PENDING") // PENDING / APPLIED / DISCARDED
  payload          Json
  sourceType       String?
  sourcePreview    String?
  toolTrace        Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewDecision   String?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?
  expiresAt        DateTime?

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([officeId, userId, status, createdAt])
  @@index([officeId, jobId, status])
  @@index([officeId, inquiryId, status])
  @@index([officeId, reviewedAt])
}

// ── Commercial decision brain ───────────────────────────────────────────────
// Durable assessment snapshots. The engine can recompute any time, but pricing
// decisions need an audit trail: what we knew, what we recommended, and why.

model StrategyAssessment {
  id                  String   @id @default(cuid())
  officeId            String
  inquiryId           String?
  jobId               String?
  entityType          String // INQUIRY / JOB
  subject             String?
  recommendation      String // QUOTE / NEGOTIATE / REQUEST_RATES / ASK_CUSTOMER / ESCALATE / DECLINE
  recommendationLabel String
  strategyMemo        String
  score               Int
  band                String
  confidence          String // low / medium / high
  components          Json
  evidence            Json
  decisionBrief       Json?
  inputHash           String
  status              String   @default("ACTIVE") // ACTIVE / SUPERSEDED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  office              Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry             Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  job                 Job?                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  routeOptions        RouteOption[]
  priceRecommendation PriceRecommendation?
  riskAssessments     RiskAssessment[]
  actions             StrategyAction[]

  @@index([officeId, status, createdAt])
  @@index([officeId, inquiryId, status, createdAt])
  @@index([officeId, jobId, status, createdAt])
  @@index([officeId, inputHash])
}

model RouteOption {
  id               String   @id @default(cuid())
  officeId         String
  assessmentId     String
  carrierQuoteId   String?
  label            String
  route            String?
  mode             String?
  provider         String?
  source           String // RECEIVED_QUOTE / LANE_RATE / HISTORY / FALLBACK
  cost             Float?
  currency         String   @default("USD")
  transitDays      Int?
  reliabilityScore Int
  riskScore        Int
  confidence       String
  tradeoff         String
  evidence         Json?
  createdAt        DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId])
  @@index([officeId, carrierQuoteId])
}

model PriceRecommendation {
  id                  String   @id @default(cuid())
  officeId            String
  assessmentId        String   @unique
  currency            String   @default("USD")
  buyCost             Float?
  costSource          String?
  floorPrice          Float?
  recommendedPrice    Float?
  stretchPrice        Float?
  walkAwayPrice       Float?
  expectedMarginPct   Float?
  expectedGrossProfit Float?
  winProbability      Int
  guardrailStatus     String // PASS / REVIEW / BLOCKED / NEEDS_COST
  rationale           Json
  createdAt           DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, guardrailStatus])
}

model RiskAssessment {
  id           String   @id @default(cuid())
  officeId     String
  assessmentId String
  category     String // CARGO / ROUTE / COMMERCIAL / CUSTOMER / CONFIDENCE / TIMING
  level        String // LOW / MEDIUM / HIGH / CRITICAL
  score        Int
  reason       String
  mitigation   String
  evidence     Json?
  createdAt    DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId])
  @@index([officeId, level, category])
}

model StrategyAction {
  id               String    @id @default(cuid())
  officeId         String
  assessmentId     String
  actionType       String // ASK_CUSTOMER / REQUEST_RATES / COUNTER_FORWARDER / QUOTE_CUSTOMER / ESCALATE / DECLINE
  priority         String // low / medium / high / critical
  status           String    @default("PROPOSED") // PROPOSED / APPROVED / APPLIED / REJECTED / FAILED
  title            String
  rationale        String
  payload          Json
  requiresApproval Boolean   @default(true)
  approvedByUserId String?
  approvedAt       DateTime?
  appliedAt        DateTime?
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId, status])
  @@index([officeId, actionType, priority, status])
}

model JobDocument {
  id               String    @id @default(cuid())
  jobId            String
  officeId         String
  name             String
  url              String?
  docType          String // BL / INVOICE / PACKING_LIST / COO / CUSTOMS / BOOKING / OTHER
  status           String    @default("PENDING") // PENDING / UPLOADED / APPROVED
  uploadedByUserId String?
  // AI-generated analysis after the doc is uploaded/approved
  aiSummary        String? // 1-3 sentence synopsis of the document content
  aiFlags          String? // JSON array of strings: red flags / discrepancies AI noticed
  aiKeyFields      String? // JSON object with extracted key fields (BL number, weight, container#, etc)
  aiAnalyzedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([officeId, docType])
}

model JobMilestone {
  id        String    @id @default(cuid())
  jobId     String
  type      String // BOOKING / ETD / ETA / CUSTOMS_ENTRY / CUSTOMS_RELEASE / DELIVERY
  plannedAt DateTime?
  actualAt  DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, type])
}

// ── Email integration ─────────────────────────────────────────────────────────

model EmailAccount {
  id           String    @id @default(cuid())
  officeId     String
  email        String
  provider     String // GMAIL / OUTLOOK / IMAP
  accessToken  String?
  refreshToken String?
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@unique([officeId, email])
  @@index([officeId])
}

model EmailThread {
  id                 String    @id @default(cuid())
  officeId           String
  jobId              String?
  inquiryId          String?
  companyId          String? // CRM company this thread's counterparty resolved to
  contactId          String? // CRM contact this thread's counterparty resolved to
  subject            String
  participants       String // JSON array of email addresses
  externalThreadId   String? // provider thread id (Gmail threadId) for direct mapping on resync
  autoLinkedAt       DateTime? // when we last attempted auto-link / auto-inquiry
  autoLinkSkipReason String? // why AI decided not to auto-create an inquiry (e.g. "not freight related")
  supplierOffer      String? // JSON {supplierName, pricePerUnit, currency, unit, qtyAvailable, incoterms, paymentTerms, leadTime, validity, sampleAvailable, notes}
  supplierOfferAt    DateTime? // when AI last extracted a supplier offer from this thread
  awardedAt          DateTime? // operator marked this supplier as winner of the sourcing deal
  hiddenAt           DateTime? // operator marked thread as not freight-related; hidden from default inbox
  snoozedUntil       DateTime? // hidden from default inbox until this time
  lastMessageAt      DateTime  @default(now())
  messageCount       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job      Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inquiry  Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  company  Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([officeId, jobId])
  @@index([officeId, inquiryId])
  @@index([officeId, lastMessageAt])
  @@index([officeId, externalThreadId])
  @@index([companyId])
  @@index([contactId])
}

model EmailMessage {
  id                   String         @id @default(cuid())
  threadId             String
  accountId            String?
  externalId           String? // provider Message-ID header for dedup
  gmailMessageId       String? // provider native message id (Gmail msg.id) - used to fetch attachments
  direction            EmailDirection
  fromEmail            String
  fromName             String?
  toEmails             String // JSON array
  ccEmails             String? // JSON array
  subject              String?
  bodyText             String?
  bodyHtml             String?
  attachments          String? // JSON array {name, url, mimeType, size}
  sentAt               DateTime       @default(now())
  isRead               Boolean        @default(false)
  classification       String? // RFQ | CARRIER_REPLY | CUSTOMER_REPLY | RELATED_NOTE | OTHER (set by AI on inbound)
  classificationReason String? // one-line AI explanation
  classificationAt     DateTime? // when the classifier last ran
  createdAt            DateTime       @default(now())

  thread  EmailThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  account EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([externalId])
  @@index([threadId, sentAt])
  @@index([accountId, sentAt])
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}
