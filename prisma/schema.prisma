generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
  EMPLOYEE // loadboard-only operator: sees loads/pipeline, nothing else
}

enum CustomerStatus {
  UNTOUCHED
  IN_PROGRESS
  WORKED
  LOST
}

enum ActivityType {
  NOTE
  VISIT
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SLACK
  RFQ
  QUOTE
  WEB_INTEL
  TASK
  AGENT_SUGGESTION
}

enum QuoteResult {
  PENDING
  WON
  LOST
}

enum CategoryType {
  CLASS1
  CLASS2
  PRODUCT
  LANE
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum JobStatus {
  PROPOSED
  INQUIRY
  QUOTED
  BOOKED
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  CANCELLED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model Office {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  companies            Company[]
  activities           Activity[]
  quotes               Quote[]
  shipments            ShipmentRecord[]
  documents            CompanyDocument[]
  laneRates            LaneRate[]
  marginProfiles       MarginProfile[]
  inquiries            Inquiry[]
  jobs                 Job[]
  jobDocuments         JobDocument[]
  emailAccounts        EmailAccount[]
  emailThreads         EmailThread[]
  assignmentChanges    AssignmentChange[]
  events               Event[]
  categories           CategoryOption[]
  tasks                Task[]
  crmOpportunities     CrmOpportunity[]
  riskAlerts           RiskAlert[]
  savedViews           SavedView[]
  targetPriceHistory   TargetPriceHistory[]
  agentProposals       AgentProposal[]
  forwarders           Forwarder[]
  forwarderDrafts      ForwarderRequestDraft[]
  carriers             Carrier[]
  carrierChecklist     CarrierChecklistItem[]
  loadSecurityChecks   LoadSecurityCheck[]
  carrierBids          CarrierBid[]
  truckloadQuotes      TruckloadQuote[]
  strategyAssessments  StrategyAssessment[]
  routeOptions         RouteOption[]
  priceRecommendations PriceRecommendation[]
  riskAssessments      RiskAssessment[]
  strategyActions      StrategyAction[]
  backgroundJobs       BackgroundJob[]
  knowledgeSources     KnowledgeSource[]
  knowledgeObjects     KnowledgeObject[]
  knowledgeChunks      KnowledgeChunk[]
  entityMentions       EntityMention[]
  memoryEvents         MemoryEvent[]
  agentMemories        AgentMemory[]
  marketSignals        MarketSignal[]
  marketSignalLinks    MarketSignalLink[]
  marketImpactReviews  MarketImpactReview[]
  marketSignalFeedback MarketSignalFeedback[]
  marketIngestionRuns  MarketIngestionRun[]
  auditLogs            AuditLog[]
  outreachPlanItems    OutreachPlanItem[]
  customerPortalUsers       CustomerPortalUser[]
  customerPortalMemberships CustomerPortalMembership[]
  customerPortalLoginCodes  CustomerPortalLoginCode[]
  customerPortalActions     CustomerPortalAction[]
  supplyWorkspaces          SupplyWorkspace[]
  supplyWorkspaceMembers    SupplyWorkspaceMember[]
  connectorInstallations    ConnectorInstallation[]
  supplyImportRuns          SupplyImportRun[]
  supplySnapshots           SupplySnapshot[]
  supplyLocations           SupplyLocation[]
  supplyItems               SupplyItem[]
  supplyItemAliases         SupplyItemAlias[]
  supplyBomVersions         SupplyBomVersion[]
  supplyBomLines            SupplyBomLine[]
  supplyInventoryPositions  SupplyInventoryPosition[]
  supplyDemands             SupplyDemand[]
  supplyMediaAssets         SupplyMediaAsset[]
  supplySupplierTerms       SupplySupplierTerm[]
  supplySupplierProfiles    SupplySupplierProfile[]
  supplyProfileFacts        SupplyProfileFact[]
  supplyBenchmarkSeries     SupplyBenchmarkSeries[]
  supplyPriceObservations   SupplyPriceObservation[]
  supplyEquivalenceRules    SupplyEquivalenceRule[]
  supplyFccProfiles         SupplyFccProfile[]
  supplyPlanningResults     SupplyPlanningResult[]
  supplyEvidence            SupplyEvidence[]
  supplyCapabilityRuns      SupplyCapabilityRun[]
  supplyDecisions           SupplyDecision[]
  supplyScenarios           SupplyScenario[]
  supplyScenarioComparisons SupplyScenarioComparison[]
  supplyDecisionEvidence    SupplyDecisionEvidence[]
  supplyScenarioEvidence    SupplyScenarioEvidence[]
  supplyApprovals           SupplyApproval[]
  supplyExecutionTasks      SupplyExecutionTask[]
  supplyExecutionEvents     SupplyExecutionEvent[]

  @@unique([name])
}

model SavedView {
  id        String   @id @default(cuid())
  officeId  String
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, userId, name])
  @@index([officeId, userId, createdAt])
}

model CategoryOption {
  id        String       @id @default(cuid())
  officeId  String
  type      CategoryType
  value     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, type, value])
  @@index([officeId, type, isActive])
}

model User {
  id                 String   @id @default(cuid())
  officeId           String
  email              String
  passwordHash       String
  fullName           String
  role               UserRole @default(SALES)
  isActive           Boolean  @default(true)
  canViewWholeOffice Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  ownedCompanies        CompanyOwner[]
  activitiesCreated     Activity[]         @relation("ActivityCreatedBy")
  assignmentChangesMade AssignmentChange[] @relation("AssignmentChangedBy")
  assignedJobs          Job[]              @relation("JobAssignee")
  assignedInquiries     Inquiry[]          @relation("InquiryAssignee")
  supplyWorkspacesCreated SupplyWorkspace[]       @relation("SupplyWorkspaceCreatedBy")
  supplyWorkspaceMembers  SupplyWorkspaceMember[]
  connectorInstallationsCreated ConnectorInstallation[] @relation("ConnectorInstallationCreatedBy")
  supplyImportRunsCreated SupplyImportRun[]       @relation("SupplyImportRunCreatedBy")
  supplySnapshotsCreated  SupplySnapshot[]        @relation("SupplySnapshotCreatedBy")
  supplyAliasesApproved   SupplyItemAlias[]       @relation("SupplyItemAliasApprovedBy")
  supplyEquivalenceRulesApproved SupplyEquivalenceRule[] @relation("SupplyEquivalenceRuleApprovedBy")
  supplyPlanningResultsCreated   SupplyPlanningResult[]  @relation("SupplyPlanningResultCreatedBy")
  supplyEvidenceCreated    SupplyEvidence[]        @relation("SupplyEvidenceCreatedBy")
  supplyProfileFactsCreated SupplyProfileFact[]     @relation("SupplyProfileFactCreatedBy")
  supplyCapabilityRuns     SupplyCapabilityRun[]   @relation("SupplyCapabilityRunInvokedBy")
  supplyDecisionsCreated   SupplyDecision[]        @relation("SupplyDecisionCreatedBy")
  supplyApprovalsRequested SupplyApproval[]        @relation("SupplyApprovalRequestedBy")
  supplyApprovalsDecided   SupplyApproval[]        @relation("SupplyApprovalDecidedBy")
  supplyExecutionTasks     SupplyExecutionTask[]   @relation("SupplyExecutionTaskCreatedBy")
  supplyExecutionEvents    SupplyExecutionEvent[]  @relation("SupplyExecutionEventActor")

  @@unique([officeId, email])
  @@index([officeId, role])
}

model Company {
  id       String         @id @default(cuid())
  officeId String
  name     String
  status   CustomerStatus @default(UNTOUCHED)

  // Category values (one per category for MVP)
  class1    String? // Passive / Potential / Active
  class2    String? // A-E
  product   String? // Sea / Air / Road / LTL / Project (MVP: single)
  lane      String? // Region e.g., "Mediterranean", "America", "Europe"
  direction String? // Import / Export / Both

  // Internal Relationship OS metadata. Existing Company remains the account
  // source of truth; these fields make it usable for customers, prospects,
  // vendors, investors, advisors, and strategic partners.
  domain               String?
  website              String?
  linkedinUrl          String?
  crmCategory          String    @default("customer")
  crmStage             String    @default("new")
  crmPriority          String    @default("medium")
  relationshipStrength String  @default("unknown")
  crmSource            String    @default("manual")
  sourceRefs           Json?
  brainSlug            String?
  crmTags              Json?
  crmNotes             String?
  lastTouchAt          DateTime?
  nextActionAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  contacts          Contact[]
  owners            CompanyOwner[]
  activities        Activity[]
  quotes            Quote[]
  shipments         ShipmentRecord[]
  documents         CompanyDocument[]
  assignmentChanges AssignmentChange[]
  tasks             Task[]
  crmOpportunities  CrmOpportunity[]
  riskAlerts        RiskAlert[]
  jobs              Job[]
  inquiries         Inquiry[]
  emailThreads      EmailThread[]
  carriers          Carrier[]
  truckloadQuotes   TruckloadQuote[]
  customerPortalMemberships CustomerPortalMembership[]
  customerPortalActions     CustomerPortalAction[]
  supplyWorkspaces           SupplyWorkspace[]
  supplySupplierProfiles     SupplySupplierProfile[]

  @@unique([officeId, name])
  @@index([officeId, status])
  @@index([officeId, crmCategory])
  @@index([officeId, crmStage])
  @@index([officeId, crmPriority])
  @@index([officeId, nextActionAt])
  @@index([officeId, class1])
  @@index([officeId, class2])
  @@index([officeId, product])
  @@index([officeId, lane])
}

model Contact {
  id                 String    @id @default(cuid())
  companyId          String
  fullName           String
  title              String?
  email              String?
  phone              String?
  notes              String?
  isApprovedForInbox Boolean   @default(false)
  approvedForInboxAt DateTime?
  linkedinUrl        String?
  bookfaceUrl        String?
  location           String?
  relationshipType   String    @default("buyer")
  leverageLevel      String    @default("medium")
  relationshipStrength String    @default("unknown")
  importance         String    @default("medium") // critical / high / medium / low
  category           String? // personally_important / startup / forwarder / other
  status             String? // not_contacted / queued / reached_out / replied / follow_up / active / not_a_fit
  outreachChannel    String? // bookface / linkedin / email
  ownerLabel         String?
  sourceRefs         Json?
  brainSlug          String?
  tags               Json?
  lastTouchAt        DateTime?
  nextActionAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities       Activity[]
  tasks            Task[]
  crmOpportunities CrmOpportunity[]
  emailThreads     EmailThread[]
  outreachPlanItems OutreachPlanItem[]

  @@index([companyId])
  @@index([companyId, isApprovedForInbox])
  @@index([companyId, relationshipType])
  @@index([companyId, leverageLevel])
  @@index([companyId, nextActionAt])
  @@index([category])
  @@index([importance])
  @@index([outreachChannel, status])
}

// One office-scoped weekly outreach slot for a contact. Contacts remain the
// source of truth; this model only records queue membership and completion.
model OutreachPlanItem {
  id           String    @id @default(cuid())
  officeId     String
  contactId    String
  weekStart    DateTime
  channel      String
  status       String    @default("WEEKLY") // WEEKLY / TODAY / REACHED_OUT / SKIPPED
  scheduledFor DateTime?
  reachedOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([officeId, contactId, weekStart])
  @@index([officeId, weekStart, channel, status])
  @@index([officeId, scheduledFor, status])
  @@index([officeId, reachedOutAt])
}

// Multiple owners per company (requested)
model CompanyOwner {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Activity {
  id         String       @id @default(cuid())
  officeId   String
  companyId  String
  contactId  String?
  inquiryId  String?
  opportunityId String?
  type       ActivityType
  occurredAt DateTime     @default(now())

  subject  String?
  body     String?
  audioUrl String?
  source   String?
  sourceRefs Json?
  provenance Json?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  office      Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiry     Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([officeId, companyId, occurredAt])
  @@index([officeId, contactId, occurredAt])
  @@index([officeId, opportunityId, occurredAt])
  @@index([officeId, inquiryId, occurredAt])
  @@index([officeId, type, occurredAt])
}

model Quote {
  id          String      @id @default(cuid())
  officeId    String
  companyId   String
  result      QuoteResult @default(PENDING)
  origin      String? // e.g. Istanbul, TR
  destination String? // e.g. Hamburg, DE
  mode        String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  value       Float?
  currency    String? // e.g. USD, EUR, TRY
  notes       String?
  lostReason  String? // Price / Competitor / No volume / Wrong lane / Other
  quotedAt    DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, companyId, quotedAt])
  @@index([officeId, result, quotedAt])
}

// Assignment changes log (audit trail)
model AssignmentChange {
  id              String   @id @default(cuid())
  officeId        String
  companyId       String
  changedByUserId String?
  createdAt       DateTime @default(now())

  // JSON snapshot for MVP simplicity (who added/removed; primary changes, etc.)
  diff Json

  office    Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("AssignmentChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([officeId, companyId, createdAt])
}

// Who changed what, where - the admin-facing activity log. One row per user
// action on a load (status change, claim, assignment, field edit, creation).
// actorEmail is denormalized so the log stays readable even if a user row
// is deactivated or removed.
model AuditLog {
  id          String  @id @default(cuid())
  officeId    String
  actorUserId String?
  actorEmail  String
  action      String // load.status_changed | load.claimed | load.assigned | load.updated | load.created
  entityType  String  @default("job")
  entityId    String?
  entityRef   String? // human ref for display, e.g. JOB-2025-001
  summary     String // one-line human-readable description
  changes     Json? // [{ field, from, to }]

  createdAt DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, createdAt])
  @@index([officeId, entityType, entityId, createdAt])
  @@index([officeId, actorUserId, createdAt])
}

// Generic event table for future risk signals / phase2 integrations
model Event {
  id         String   @id @default(cuid())
  officeId   String
  type       String
  entityType String?
  entityId   String?
  payload    Json
  createdAt  DateTime @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, type, createdAt])
  @@index([officeId, entityType, entityId])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  officeId    String
  type        String
  status      String    @default("QUEUED") // QUEUED / RUNNING / DONE / FAILED
  payload     Json
  dedupeKey   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId, status, runAfter])
  @@index([officeId, type, status])
  @@index([dedupeKey, status])
}

// Canonical company-brain source registry. This is intentionally generic:
// Gmail, WhatsApp, Sheets, CRM rows, documents, strategy snapshots, and agent
// outputs can all become memory without rewriting the current product flows.
model KnowledgeSource {
  id          String   @id @default(cuid())
  officeId    String
  type        String
  label       String?
  externalId  String?
  status      String   @default("ACTIVE")
  trustLevel  String   @default("INTERNAL")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  objects       KnowledgeObject[]
  events        MemoryEvent[]
  agentMemories AgentMemory[]

  @@unique([officeId, type, externalId])
  @@index([officeId, type, status])
}

model KnowledgeObject {
  id                   String   @id @default(cuid())
  officeId             String
  sourceId             String?
  sourceType           String
  sourceExternalId     String
  canonicalType        String
  title                String?
  contentHash          String?
  rawRef               String?
  visibility           String   @default("INTERNAL")
  retentionPolicy      String   @default("DEFAULT")
  entityType           String?
  entityId             String?
  companyId            String?
  contactId            String?
  inquiryId            String?
  jobId                String?
  emailThreadId        String?
  emailMessageId       String?
  jobDocumentId        String?
  strategyAssessmentId String?
  agentProposalId      String?
  occurredAt           DateTime
  ingestedAt           DateTime @default(now())
  payloadVersion       Int      @default(1)
  payload              Json
  provenance           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  office        Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source        KnowledgeSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  chunks        KnowledgeChunk[]
  mentions      EntityMention[]
  events        MemoryEvent[]
  agentMemories AgentMemory[]
  marketSignals MarketSignal[]

  @@unique([officeId, sourceType, sourceExternalId])
  @@index([officeId, canonicalType, occurredAt])
  @@index([officeId, entityType, entityId])
  @@index([officeId, companyId, occurredAt])
  @@index([officeId, jobId, occurredAt])
  @@index([officeId, inquiryId, occurredAt])
  @@index([officeId, emailThreadId])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  officeId       String
  objectId       String
  ordinal        Int      @default(0)
  kind           String   @default("TEXT")
  text           String
  tokenCount     Int?
  sourceSpan     Json?
  metadata       Json?
  payloadVersion Int      @default(1)
  provenance     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  office   Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  object   KnowledgeObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  mentions EntityMention[]

  @@unique([objectId, ordinal])
  @@index([officeId, objectId])
}

model EntityMention {
  id             String   @id @default(cuid())
  officeId       String
  objectId       String?
  chunkId        String?
  entityType     String
  entityId       String
  label          String?
  confidence     Float?
  source         String   @default("SYSTEM")
  metadata       Json?
  payloadVersion Int      @default(1)
  provenance     Json
  createdAt      DateTime @default(now())

  office Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  object KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)
  chunk  KnowledgeChunk?  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([officeId, entityType, entityId])
  @@index([officeId, objectId])
  @@index([officeId, chunkId])
}

model MemoryEvent {
  id               String   @id @default(cuid())
  officeId         String
  sourceId         String?
  objectId         String?
  sourceType       String
  sourceExternalId String?
  eventType        String
  entityType       String
  entityId         String
  actorType        String?
  actorId          String?
  occurredAt       DateTime
  ingestedAt       DateTime @default(now())
  idempotencyKey   String?
  payloadVersion   Int      @default(1)
  payload          Json
  provenance       Json
  createdAt        DateTime @default(now())

  office        Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source        KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  object        KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  agentMemories AgentMemory[]

  @@unique([officeId, idempotencyKey])
  @@index([officeId, eventType, occurredAt])
  @@index([officeId, entityType, entityId, occurredAt])
  @@index([officeId, sourceType, sourceExternalId])
}

model AgentMemory {
  id             String    @id @default(cuid())
  officeId       String
  sourceId       String?
  objectId       String?
  eventId        String?
  agentName      String
  memoryType     String
  subjectType    String?
  subjectId      String?
  companyId      String?
  jobId          String?
  inquiryId      String?
  content        String
  status         String    @default("ACTIVE")
  confidence     Float?
  payloadVersion Int       @default(1)
  payload        Json?
  provenance     Json
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  office Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  object KnowledgeObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  event  MemoryEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([officeId, agentName, status])
  @@index([officeId, memoryType, status])
  @@index([officeId, subjectType, subjectId])
  @@index([officeId, companyId])
  @@index([officeId, jobId])
  @@index([officeId, inquiryId])
}

model MarketSignal {
  id                   String   @id @default(cuid())
  officeId             String
  sourceObjectId       String?
  category             String
  severity             String
  confidence           Float
  affectedModes        Json
  affectedOrigins      Json
  affectedDestinations Json
  affectedPorts        Json
  affectedLanes        Json
  affectedCarriers     Json
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  summary              String
  operatorImplication  String?
  pricingImplication   String?
  customerImpact       String?
  recommendedActions   Json
  sourceRefs           Json
  dedupeKey            String
  payloadVersion       Int      @default(1)
  provenance           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  office       Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  sourceObject KnowledgeObject?    @relation(fields: [sourceObjectId], references: [id], onDelete: SetNull)
  links        MarketSignalLink[]
  impactReviews MarketImpactReview[]
  feedback     MarketSignalFeedback[]

  @@unique([officeId, dedupeKey])
  @@index([officeId, category, severity, createdAt])
  @@index([officeId, effectiveFrom, effectiveTo])
  @@index([officeId, sourceObjectId])
}

model MarketSignalLink {
  id         String   @id @default(cuid())
  officeId   String
  signalId   String
  entityType String
  entityId   String
  matchType  String
  confidence Float
  reason     String?
  createdAt  DateTime @default(now())

  office Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  signal MarketSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  impactReviews MarketImpactReview[]

  @@unique([signalId, entityType, entityId])
  @@index([officeId, entityType, entityId])
  @@index([officeId, signalId])
}

model MarketImpactReview {
  id                 String   @id @default(cuid())
  officeId           String
  marketSignalId     String
  marketSignalLinkId String?
  linkedEntityType   String
  linkedEntityId     String
  impactLevel        String
  impactReason       String
  recommendedAction  String?
  status             String   @default("pending")
  feedbackKind       String?
  feedbackNote       String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  actionedAt         DateTime?
  sourceRefs         Json
  payloadVersion     Int      @default(1)
  provenance         Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  office           Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  marketSignal     MarketSignal        @relation(fields: [marketSignalId], references: [id], onDelete: Cascade)
  marketSignalLink MarketSignalLink?   @relation(fields: [marketSignalLinkId], references: [id], onDelete: SetNull)
  feedback         MarketSignalFeedback[]

  @@unique([officeId, marketSignalId, linkedEntityType, linkedEntityId])
  @@index([officeId, status])
  @@index([marketSignalId])
  @@index([linkedEntityType, linkedEntityId])
  @@index([createdAt])
}

model MarketSignalFeedback {
