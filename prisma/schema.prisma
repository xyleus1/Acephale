  customerTier  String? // new / existing / vip
  urgency       String? // normal / asap / flexible
  marginPercent Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@index([officeId])
}

// Cache of computed summaries per Inquiry. Avoids re-running the extraction
// + sort + JSON shaping on every agent query. Keyed by inquiryId, with kind
// distinguishing different summary shapes (e.g. supplier-shortlist).
model Inquiry {
  id                String    @id @default(cuid())
  officeId          String
  companyId         String?
  reference         String? // freight file number, e.g. DRY26070001 - assigned at intake, carried onto the converted load
  subject           String
  fromEmail         String?
  fromCompany       String?
  origin            String?
  destination       String?
  mode              String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  containerCount    Int?
  containerType     String? // 20GP / 40HC / 40DRY / 20DRY etc.
  packages          Int?
  dimensions        String? // JSON [{qty, length, width, height}] in cm
  stackable         String? // YES / NO / UNKNOWN
  topLoad           String? // YES / NO / UNKNOWN, only relevant when stackable=NO
  dangerousGoods    String? // YES / NO / UNKNOWN
  customsBy         String? // US / CUSTOMER / FORWARDER / UNKNOWN
  commodity         String?
  weight            Float?
  volume            Float?
  incoterms         String?
  targetPrice       Float?
  targetCurrency    String?
  targetPriceStatus String? // UNKNOWN / PROVIDED / NO_TARGET
  targetPriceSource String?
  cargoReadyDate    DateTime?
  // High-value tech-freight fields (vocab in src/lib/security-sop.ts)
  declaredValue         Float?
  declaredValueCurrency String?
  securityTier          String? // standard / elevated / high_value / critical
  commodityCategory     String? // tech commodity taxonomy, e.g. servers_gpu
  trackingType          String? // none / phone_check / eld_app / gps_device / escort
  equipmentType         String? // DRY_VAN / REEFER / FLATBED / … - first-class truck equipment
  teamDriversRequired   String? // YES / NO / UNKNOWN
  type              String    @default("FORWARDING") // FORWARDING (move customer's cargo) | SOURCING (find + buy a commodity for customer)
  status            String    @default("INGESTED") // INGESTED / PARSED / PRICED / QUOTED / WON / LOST
  // RFQ desk workflow (2026-07-24): who owns the RFQ + operator-entered truth
  // that survives lead resyncs (resync never writes these columns).
  assignedToUserId  String?
  contactName       String?
  contactPhone      String?
  manualDetails     String? // real details pasted from WhatsApp - the truth when form answers are noise
  forwardedTo       String? // JSON string[] of partner forwarders this RFQ went to (see src/lib/forwarder-partners.ts)
  rawEmailBody      String?
  parsedData        String? // JSON: AI-extracted fields
  notes             String?
  // Pre-computed summary cache (JSON). Used by the agent's
  // summarize_supplier_offers tool to skip re-parsing + ranking on every
  // query. Cleared whenever a linked thread is added/updated/awarded so
  // the next read regenerates.
  summaryCache      String?
  summaryCacheAt    DateTime?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office              Office                  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company             Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo          User?                   @relation("InquiryAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  carrierQuotes       CarrierQuote[]
  job                 Job?
  emailThreads        EmailThread[]
  targetPriceHistory  TargetPriceHistory[]
  agentProposals      AgentProposal[]
  forwarderDrafts     ForwarderRequestDraft[]
  strategyAssessments StrategyAssessment[]
  crmOpportunities    CrmOpportunity[]
  activities          Activity[]
  tasks               Task[]
  carrierBids         CarrierBid[]
  truckloadQuotes     TruckloadQuote[]
  customerPortalActions CustomerPortalAction[]

  @@unique([officeId, reference])
  @@index([officeId, status, receivedAt])
  @@index([officeId, companyId])
  @@index([officeId, assignedToUserId])
}

model TargetPriceHistory {
  id              String   @id @default(cuid())
  officeId        String
  inquiryId       String?
  jobId           String?
  amount          Float?
  currency        String?
  status          String   @default("UNKNOWN") // PROVIDED / NO_TARGET / UNKNOWN
  source          String?
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([officeId, inquiryId, createdAt])
  @@index([officeId, jobId, createdAt])
}

model CarrierQuote {
  id             String   @id @default(cuid())
  inquiryId      String
  carrier        String
  quoteType      String   @default("EMAIL") // API / EMAIL
  rateName       String?
  total20        Float?
  total40        Float?
  total40HC      Float?
  transitDays    Int?
  service        String?
  validity       String?
  transshipments String?
  status         String   @default("PENDING") // PENDING / RECEIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model Forwarder {
  id           String   @id @default(cuid())
  officeId     String
  name         String
  email        String
  modeCoverage String? // comma-separated modes, blank means all modes
  apiType      String   @default("EMAIL") // EMAIL / API
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  office        Office                  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  requestDrafts ForwarderRequestDraft[]

  @@unique([officeId, email])
  @@index([officeId, active])
}

model ForwarderRequestDraft {
  id              String    @id @default(cuid())
  officeId        String
  inquiryId       String
  forwarderId     String?
  forwarderName   String
  toEmail         String
  subject         String
  body            String
  status          String    @default("DRAFT") // DRAFT / DISCARDED / SENT
  createdByUserId String?
  senderAccountId String?
  sentByEmail     String?
  sentAt          DateTime?
  gmailMessageId  String?
  gmailThreadId   String?
  sendError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry   Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  forwarder Forwarder? @relation(fields: [forwarderId], references: [id], onDelete: SetNull)

  @@index([officeId, inquiryId, status])
  @@index([officeId, forwarderId])
}

// Per-load security SOP checklist, seeded from the load's securityTier
// (template + tier logic in src/lib/security-sop.ts). The checklist is the
// operator-facing half of the trust artifact; a customer-safe rendering
// lands on the portal later.
model LoadSecurityCheck {
  id                String    @id @default(cuid())
  officeId          String
  jobId             String
  key               String // securityChecklistTemplate key
  label             String
  status            String    @default("pending") // pending / done / na / flagged
  note              String?
  completedByUserId String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
  @@index([officeId, jobId, status])
}

// The vetted trucking-carrier bench for US domestic (CA tech-freight niche).
// Operational entity, deliberately separate from Forwarder (intl supplier
// directory) and from CRM Company (relationship layer; optional link only).
// Vocabulary lives in src/lib/carrier-vetting.ts.
model Carrier {
  id        String  @id @default(cuid())
  officeId  String
  companyId String? // optional link to a CRM Company; never auto-created
  name      String
  legalName String?
  mcNumber  String? // FMCSA MC number
  dotNumber String? // USDOT number
  scac      String?

  // Contact + deceptive-pickup (carrier impersonation) defense
  dispatchEmail        String?
  dispatchPhone        String?
  verifiedPhone        String? // callback number verified against FMCSA/insurance producer records
  emailDomain          String? // expected corporate mail domain (freemail dispatch = flag)
  emailDomainVerified  Boolean   @default(false)
  factoringCompany     String?
  authorityFirstActive DateTime? // young authority is a fraud signal
  fraudFlags           Json? // [{flag, note, at, byUserId}]
  identityVerifiedAt   DateTime?
  identityVerifiedBy   String?

  // Authority + insurance (manual V1 - no FMCSA/RMIS API)
  authorityStatus        String? // active / inactive / revoked / unknown
  insuranceProducer      String? // agency the COI was verified with, direct
  autoLiabilityLimit     Float?
  cargoLimit             Float?
  autoInsuranceExpiry    DateTime?
  cargoInsuranceExpiry   DateTime?
  coiUrl                 String?
  highValueApprovedLimit Float? // max declared value we give them without a special rider

  // Equipment + capability
  equipmentTypes   Json? // ["DRY_VAN","REEFER",...] - DomesticEquipmentType strings
  airRide          Boolean @default(false)
  liftgate         Boolean @default(false)
  blanketWrap      Boolean @default(false)
  teamDrivers      Boolean @default(false)
  hazmatCertified  Boolean @default(false)
  lithiumCapable   Boolean @default(false) // UN3480/3481 experience
  reeferCapable    Boolean @default(false)
  securityFeatures Json? // ["high_security_locks","covert_gps","geofencing",...]
  serviceStates    Json? // ["CA","NV","AZ",...]
  homeBase         String? // e.g. "Fremont, CA"

  // Vetting workflow - gate logic in carrierVettingGate()
  vettingStatus  String    @default("prospect")
  vettingNotes   String?
  vettedAt       DateTime?
  vettedByUserId String?
  nextReviewAt   DateTime? // driven by the nearest insurance expiry

  // Scorecard - columns reserved now, auto-computed from load history later
  loadsCompleted    Int       @default(0)
  onTimePickupPct   Float?
  onTimeDeliveryPct Float?
  claimCount        Int       @default(0)
  incidentCount     Int       @default(0)
  scorecardScore    Float?
  scorecardAt       DateTime?

  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office    Office                 @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company   Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  checklist CarrierChecklistItem[]
  bids      CarrierBid[]

  @@unique([officeId, mcNumber])
  @@unique([officeId, dotNumber])
  @@index([officeId, vettingStatus, active])
  @@index([officeId, name])
  @@index([officeId, cargoInsuranceExpiry])
}

// One row per vetting-checklist item per carrier; template + gate logic in
// src/lib/carrier-vetting.ts. Evidence is a paste-URL in V1.
model CarrierChecklistItem {
  id              String    @id @default(cuid())
  officeId        String
  carrierId       String
  key             String // CARRIER_VETTING_CHECKLIST key
  label           String
  status          String    @default("pending") // pending / passed / failed / waived
  note            String?
  evidenceUrl     String?
  checkedByUserId String?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([carrierId, key])
  @@index([officeId, carrierId, status])
}

// Truckload buy-side quote from a carrier (per-load $, not ocean totals -
// CarrierQuote stays ocean-shaped for the intl stack). Bids link to the
// vetted bench when the carrier is onboarded; carrierName covers the rest.
model CarrierBid {
  id            String    @id @default(cuid())
  officeId      String
  inquiryId     String?
  jobId         String?
  carrierId     String?
  carrierName   String
  equipmentType String? // DRY_VAN / REEFER / … (pricing-engine strings)
  linehaulAmount    Float?
  fscAmount         Float? // fuel surcharge
  accessorialAmount Float?
  totalAmount       Float? // all-in per-load buy
  currency      String    @default("USD")
  miles         Float?
  ratePerMile   Float? // stored, not derived - operator-entered all-in rates survive
  transitDays   Int?
  validUntil    DateTime?
  source        String    @default("MANUAL") // MANUAL / EMAIL / WHATSAPP / PHONE / LOADBOARD / API
  status        String    @default("RECEIVED") // REQUESTED / RECEIVED / DECLINED / SELECTED / EXPIRED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  carrier Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([officeId, inquiryId])
  @@index([officeId, jobId])
  @@index([officeId, carrierId, createdAt])
}

// Sell-side truckload quote + outcome - one row per issued quote version.
// This is the data flywheel: normalized lane x equipment x tier with buy/sell
// economics, quote speed, and win/loss. Vocab in src/lib/truckload-quote-fields.ts.
model TruckloadQuote {
  id        String  @id @default(cuid())
  officeId  String
  inquiryId String?
  jobId     String?
  companyId String?

  // Normalized lane - corridor keys for aggregation
  origin            String?
  destination       String?
  originState       String? // classifyDomesticLocation().stateCode
  destState         String?
  miles             Float?
  mode              String? // FTL / LTL / PARTIAL / DRAYAGE
  equipmentType     String?
  commodityCategory String?
  securityTier      String?
  declaredValue     Float?

  // Economics
  buyAmount    Float?
  buySource    String? // mock / manual / carrier_bid / live:<provider>
  carrierBidId String?
  carrierId    String? // winning/selected carrier once known
  sellAmount   Float?
  currency     String  @default("USD")
  marginPct    Float?
  grossProfit  Float?
  ratePerMile  Float?

  // Quote speed + outcome
  sentVia       String? // EMAIL / WHATSAPP / PORTAL / NONE
  sentAt        DateTime?
  rfqReceivedAt DateTime? // copied from inquiry.receivedAt - quote-speed KPI
  outcome       String    @default("PENDING") // PENDING / WON / LOST / EXPIRED / NO_QUOTE
  outcomeReason String? // price_too_high / no_capacity / too_slow / …
  outcomeNote   String?
  outcomeAt     DateTime?
  decidedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([officeId, outcome, createdAt])
  @@index([officeId, originState, destState, equipmentType])
  @@index([officeId, inquiryId])
  @@index([officeId, companyId, createdAt])
}

// Shipment history - populated from Siber in Phase 2, or manually entered
model ShipmentRecord {
  id           String   @id @default(cuid())
  officeId     String
  companyId    String
  origin       String?
  destination  String?
  mode         String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  weight       Float? // kg
  volume       Float? // cbm
  revenue      Float?
  profit       Float?
  currency     String?  @default("USD")
  shipmentDate DateTime
  reference    String? // Siber / carrier reference number
  source       String   @default("manual") // "siber" | "manual"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([officeId, companyId, shipmentDate])
  @@index([officeId, shipmentDate])
}

// ── Jobs (forwarding operations) ─────────────────────────────────────────────

model Job {
  id               String  @id @default(cuid())
  officeId         String
  companyId        String?
  assignedToUserId String?
  inquiryId        String? @unique // set when converted from an Inquiry

  reference         String // e.g. JOB-2025-001
  title             String? // human deal name, e.g. "China Spare Parts" - how the user recalls the load
  cadence           String? // ONE_OFF | MONTHLY - recurring business vs one-shot
  status            JobStatus @default(INQUIRY)
  type              String    @default("FORWARDING") // FORWARDING | SOURCING
  mode              String? // AIR / SEA-FCL / SEA-LCL / ROAD / COURIER
  origin            String?
  destination       String?
  commodity         String?
  incoterms         String?
  weight            Float? // kg
  volume            Float? // cbm - auto-computed from dimensions for non-FCL
  packages          Int?
  dimensions        String? // JSON [{qty, length, width, height}] in cm - LCL/AIR/ROAD cargo
  stackable         String? // YES / NO / UNKNOWN
  topLoad           String? // YES / NO / UNKNOWN, only relevant when stackable=NO
  dangerousGoods    String? // YES / NO / UNKNOWN
  customsBy         String? // US / CUSTOMER / FORWARDER / UNKNOWN
  containerCount    Int? // FCL: number of containers
  containerType     String? // FCL: 20DC / 40DC / 40HC / 20RF / 40RF / OT-FR
  quantity          Float? // generic deal quantity, e.g. 350 (TONS), 3 (TRUCKS)
  quantityUnit      String? // TONS / TRUCKS / PALLETS / UNITS / KG / CBM - free text
  targetPrice       Float?
  targetCurrency    String?
  targetPriceStatus String? // UNKNOWN / PROVIDED / NO_TARGET
  targetPriceSource String?
  quoteLines        String? // pipe-delimited quote line items (desc|amount|currency per line)
  // High-value tech-freight fields (vocab in src/lib/security-sop.ts)
  declaredValue         Float?
  declaredValueCurrency String?
  securityTier          String? // standard / elevated / high_value / critical
  commodityCategory     String? // tech commodity taxonomy, e.g. servers_gpu
  trackingType          String? // none / phone_check / eld_app / gps_device / escort
  equipmentType         String? // DRY_VAN / REEFER / FLATBED / … - first-class truck equipment
  teamDriversRequired   String? // YES / NO / UNKNOWN

  etd DateTime?
  eta DateTime?

  revenue  Float?
  cost     Float?
  currency String @default("USD")

  notes          String?
  portalToken    String?  @unique // public magic-link token for /portal/[token]
  notifyCustomer Boolean  @default(true) // auto-email customer on status/milestone changes
  customerEmail  String? // override for status-update emails; defaults to inquiry.fromEmail
  parentJobId    String? // when a SOURCING award spins up a child FORWARDING job
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  office              Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  inquiry             Inquiry?             @relation(fields: [inquiryId], references: [id])
  assignedTo          User?                @relation("JobAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parent              Job?                 @relation("JobParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  children            Job[]                @relation("JobParent")
  documents           JobDocument[]
  milestones          JobMilestone[]
  emailThreads        EmailThread[]
  targetPriceHistory  TargetPriceHistory[]
  agentProposals      AgentProposal[]
  strategyAssessments StrategyAssessment[]
  securityChecks      LoadSecurityCheck[]
  carrierBids         CarrierBid[]
  truckloadQuotes     TruckloadQuote[]
  customerPortalActions CustomerPortalAction[]

  @@unique([officeId, reference])
  @@index([officeId, status, createdAt])
  @@index([officeId, companyId])
  @@index([officeId, assignedToUserId])
}

model AgentProposal {
  id               String    @id @default(cuid())
  officeId         String
  userId           String?
  jobId            String?
  inquiryId        String?
  kind             String
  status           String    @default("PENDING") // PENDING / APPLIED / DISCARDED
  payload          Json
  sourceType       String?
  sourcePreview    String?
  toolTrace        Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewDecision   String?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?
  expiresAt        DateTime?

  office  Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([officeId, userId, status, createdAt])
  @@index([officeId, jobId, status])
  @@index([officeId, inquiryId, status])
  @@index([officeId, reviewedAt])
}

// ── Commercial decision brain ───────────────────────────────────────────────
// Durable assessment snapshots. The engine can recompute any time, but pricing
// decisions need an audit trail: what we knew, what we recommended, and why.

model StrategyAssessment {
  id                  String   @id @default(cuid())
  officeId            String
  inquiryId           String?
  jobId               String?
  entityType          String // INQUIRY / JOB
  subject             String?
  recommendation      String // QUOTE / NEGOTIATE / REQUEST_RATES / ASK_CUSTOMER / ESCALATE / DECLINE
  recommendationLabel String
  strategyMemo        String
  score               Int
  band                String
  confidence          String // low / medium / high
  components          Json
  evidence            Json
  decisionBrief       Json?
  inputHash           String
  status              String   @default("ACTIVE") // ACTIVE / SUPERSEDED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  office              Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  inquiry             Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  job                 Job?                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  routeOptions        RouteOption[]
  priceRecommendation PriceRecommendation?
  riskAssessments     RiskAssessment[]
  actions             StrategyAction[]

  @@index([officeId, status, createdAt])
  @@index([officeId, inquiryId, status, createdAt])
  @@index([officeId, jobId, status, createdAt])
  @@index([officeId, inputHash])
}

model RouteOption {
  id               String   @id @default(cuid())
  officeId         String
  assessmentId     String
  carrierQuoteId   String?
  label            String
  route            String?
  mode             String?
  provider         String?
  source           String // RECEIVED_QUOTE / LANE_RATE / HISTORY / FALLBACK
  cost             Float?
  currency         String   @default("USD")
  transitDays      Int?
  reliabilityScore Int
  riskScore        Int
  confidence       String
  tradeoff         String
  evidence         Json?
  createdAt        DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId])
  @@index([officeId, carrierQuoteId])
}

model PriceRecommendation {
  id                  String   @id @default(cuid())
  officeId            String
  assessmentId        String   @unique
  currency            String   @default("USD")
  buyCost             Float?
  costSource          String?
  floorPrice          Float?
  recommendedPrice    Float?
  stretchPrice        Float?
  walkAwayPrice       Float?
  expectedMarginPct   Float?
  expectedGrossProfit Float?
  winProbability      Int
  guardrailStatus     String // PASS / REVIEW / BLOCKED / NEEDS_COST
  rationale           Json
  createdAt           DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, guardrailStatus])
}

model RiskAssessment {
  id           String   @id @default(cuid())
  officeId     String
  assessmentId String
  category     String // CARGO / ROUTE / COMMERCIAL / CUSTOMER / CONFIDENCE / TIMING
  level        String // LOW / MEDIUM / HIGH / CRITICAL
  score        Int
  reason       String
  mitigation   String
  evidence     Json?
  createdAt    DateTime @default(now())

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId])
  @@index([officeId, level, category])
}

model StrategyAction {
  id               String    @id @default(cuid())
  officeId         String
  assessmentId     String
  actionType       String // ASK_CUSTOMER / REQUEST_RATES / COUNTER_FORWARDER / QUOTE_CUSTOMER / ESCALATE / DECLINE
  priority         String // low / medium / high / critical
  status           String    @default("PROPOSED") // PROPOSED / APPROVED / APPLIED / REJECTED / FAILED
  title            String
  rationale        String
  payload          Json
  requiresApproval Boolean   @default(true)
  approvedByUserId String?
  approvedAt       DateTime?
  appliedAt        DateTime?
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  assessment StrategyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([officeId, assessmentId, status])
  @@index([officeId, actionType, priority, status])
}

model JobDocument {
  id               String    @id @default(cuid())
  jobId            String
  officeId         String
  name             String
  url              String?
  docType          String // BL / INVOICE / PACKING_LIST / COO / CUSTOMS / BOOKING / OTHER
  status           String    @default("PENDING") // PENDING / UPLOADED / APPROVED
  uploadedByUserId String?
  uploadedByPortalUserId String?
  customerVisible Boolean   @default(false)
  customerRequested Boolean @default(false)
  // AI-generated analysis after the doc is uploaded/approved
  aiSummary        String? // 1-3 sentence synopsis of the document content
  aiFlags          String? // JSON array of strings: red flags / discrepancies AI noticed
  aiKeyFields      String? // JSON object with extracted key fields (BL number, weight, container#, etc)
  aiAnalyzedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  uploadedByPortalUser CustomerPortalUser? @relation(fields: [uploadedByPortalUserId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([officeId, docType])
  @@index([officeId, customerVisible, customerRequested, status], map: "JobDocument_portal_visibility_idx")
}

model JobMilestone {
  id        String    @id @default(cuid())
  jobId     String
  type      String // BOOKING / ETD / ETA / CUSTOMS_ENTRY / CUSTOMS_RELEASE / DELIVERY
  plannedAt DateTime?
  actualAt  DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, type])
}

// ── Email integration ─────────────────────────────────────────────────────────

model EmailAccount {
  id           String    @id @default(cuid())
  officeId     String
  email        String
  provider     String // GMAIL / OUTLOOK / IMAP
  accessToken  String?
  refreshToken String?
  isActive     Boolean   @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@unique([officeId, email])
  @@index([officeId])
}

model EmailThread {
  id                 String    @id @default(cuid())
  officeId           String
  jobId              String?
  inquiryId          String?
  companyId          String? // CRM company this thread's counterparty resolved to
  contactId          String? // CRM contact this thread's counterparty resolved to
  subject            String
  participants       String // JSON array of email addresses
  externalThreadId   String? // provider thread id (Gmail threadId) for direct mapping on resync
  autoLinkedAt       DateTime? // when we last attempted auto-link / auto-inquiry
  autoLinkSkipReason String? // why AI decided not to auto-create an inquiry (e.g. "not freight related")
  supplierOffer      String? // JSON {supplierName, pricePerUnit, currency, unit, qtyAvailable, incoterms, paymentTerms, leadTime, validity, sampleAvailable, notes}
  supplierOfferAt    DateTime? // when AI last extracted a supplier offer from this thread
  awardedAt          DateTime? // operator marked this supplier as winner of the sourcing deal
  hiddenAt           DateTime? // operator marked thread as not freight-related; hidden from default inbox
  snoozedUntil       DateTime? // hidden from default inbox until this time
  lastMessageAt      DateTime  @default(now())
  messageCount       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  job      Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inquiry  Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  company  Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([officeId, jobId])
  @@index([officeId, inquiryId])
  @@index([officeId, lastMessageAt])
  @@index([officeId, externalThreadId])
  @@index([companyId])
  @@index([contactId])
}

model EmailMessage {
  id                   String         @id @default(cuid())
  threadId             String
  accountId            String?
  externalId           String? // provider Message-ID header for dedup
  gmailMessageId       String? // provider native message id (Gmail msg.id) - used to fetch attachments
  direction            EmailDirection
  fromEmail            String
  fromName             String?
  toEmails             String // JSON array
  ccEmails             String? // JSON array
  subject              String?
  bodyText             String?
  bodyHtml             String?
  attachments          String? // JSON array {name, url, mimeType, size}
  sentAt               DateTime       @default(now())
  isRead               Boolean        @default(false)
  classification       String? // RFQ | CARRIER_REPLY | CUSTOMER_REPLY | RELATED_NOTE | OTHER (set by AI on inbound)
  classificationReason String? // one-line AI explanation
  classificationAt     DateTime? // when the classifier last ran
  createdAt            DateTime       @default(now())

  thread  EmailThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  account EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([externalId])
  @@index([threadId, sentAt])
  @@index([accountId, sentAt])
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

// External customer identity. This is intentionally separate from the
// internal User model and its founder/operator allowlist.
model CustomerPortalUser {
  id        String  @id @default(cuid())
  officeId  String
  email     String
  fullName  String?
  isActive  Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office      Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  memberships CustomerPortalMembership[]
  loginCodes  CustomerPortalLoginCode[]
  actions     CustomerPortalAction[]
  uploads     JobDocument[]

  @@unique([officeId, email])
  @@index([officeId, isActive])
}

// Company access is explicit and revocable. It is never inferred from CRM
// contact records or email-domain matching.
model CustomerPortalMembership {
  id        String  @id @default(cuid())
  officeId  String
  userId    String
  companyId String
  role      String  @default("MEMBER") // ADMIN / MEMBER / VIEWER
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office  Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user    CustomerPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([officeId, companyId, isActive])
  @@index([officeId, userId, isActive])
}

// Customer sign-in codes never share the internal LoginCode table. This keeps
// the external portal from weakening the internal operator allowlist.
model CustomerPortalLoginCode {
  id         String    @id @default(cuid())
  officeId   String
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  office Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   CustomerPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([officeId, email, createdAt])
  @@index([userId, createdAt])
}

// Customer writes are requests for operator review. They do not silently
// advance job status, book freight, or overwrite operational truth.
model CustomerPortalAction {
  id           String  @id @default(cuid())
  officeId     String
  companyId    String
  jobId        String?
  inquiryId    String?
  portalUserId String
  type         String // QUOTE_ACCEPTED / QUOTE_CHANGES_REQUESTED / DOCUMENT_UPLOADED
  status       String @default("PENDING") // PENDING / ACKNOWLEDGED / RESOLVED / REJECTED
  message      String?
  payload      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office     Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job        Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inquiry    Inquiry?           @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  portalUser CustomerPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([officeId, status, createdAt])
  @@index([officeId, companyId, createdAt])
  @@index([officeId, jobId, createdAt])
  @@index([portalUserId, createdAt])
}

// Shared, office-scoped Supply OS workspace. Browser-local presentation state
// may point here, but this record is the durable collaboration boundary.
model SupplyWorkspace {
  id              String  @id @default(cuid())
  officeId        String
  companyId       String?
  createdByUserId String?
  externalKey     String?
  name            String
  status          String  @default("ACTIVE") // ACTIVE / ARCHIVED
  version         Int     @default(1)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("SupplyWorkspaceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  members     SupplyWorkspaceMember[]
  importRuns  SupplyImportRun[]
  snapshots   SupplySnapshot[]
  locations   SupplyLocation[]
  items       SupplyItem[]
  itemAliases SupplyItemAlias[]
  bomVersions SupplyBomVersion[]
  bomLines    SupplyBomLine[]
  inventory   SupplyInventoryPosition[]
  demands     SupplyDemand[]
  mediaAssets SupplyMediaAsset[]
  supplierTerms    SupplySupplierTerm[]
  supplierProfiles SupplySupplierProfile[]
  profileFacts SupplyProfileFact[]
  benchmarkSeries SupplyBenchmarkSeries[]
  priceObservations SupplyPriceObservation[]
  equivalenceRules SupplyEquivalenceRule[]
  fccProfiles      SupplyFccProfile[]
  planningResults  SupplyPlanningResult[]
  evidence            SupplyEvidence[]
  capabilityRuns      SupplyCapabilityRun[]
  decisions           SupplyDecision[]
  scenarios           SupplyScenario[]
  scenarioComparisons SupplyScenarioComparison[]
  decisionEvidence    SupplyDecisionEvidence[]
  scenarioEvidence    SupplyScenarioEvidence[]
  approvals           SupplyApproval[]
  executionTasks      SupplyExecutionTask[]
  executionEvents     SupplyExecutionEvent[]
  connectorInstallations ConnectorInstallation[]

  @@unique([officeId, externalKey])
  @@index([officeId, status, updatedAt])
  @@index([officeId, companyId, status])
}

// Explicit membership supports shared office state without granting every
// restricted operator access to every workspace.
model SupplyWorkspaceMember {
  id          String  @id @default(cuid())
  officeId    String
  workspaceId String
  userId      String
  role        String  @default("MEMBER") // OWNER / EDITOR / MEMBER / VIEWER
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([officeId, userId, isActive])
  @@index([officeId, workspaceId, isActive])
}

// One server-side connection to a client system. Credentials are never stored
// here. secretRef identifies a deployment-environment secret containing the
// OAuth client credentials.
model ConnectorInstallation {
  id               String   @id @default(cuid())
  officeId         String
  workspaceId      String
  createdByUserId  String?
  adapterKey       String
  adapterVersion   String
  displayName      String
  baseUrl          String
  authType         String   @default("OAUTH_CLIENT_CREDENTIALS")
  secretRef        String
  config           Json
  scheduleMinutes  Int      @default(60)
  status           String   @default("DISABLED")
  currentCursor    Json?
  lastTraceId      String?
  lastErrorCode    String?
  lastErrorMessage String?
  lastTestedAt     DateTime?
  lastStartedAt    DateTime?
  lastSucceededAt  DateTime?
  lastFailedAt     DateTime?
  nextSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  office     Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace  SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("ConnectorInstallationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  importRuns SupplyImportRun[]

  @@unique([workspaceId, adapterKey])
  @@index([officeId, status, nextSyncAt])
  @@index([officeId, workspaceId, updatedAt])
}

// One connector execution. A successful run may publish exactly one immutable
// snapshot. Raw files remain outside this table and are referenced by hash.
model SupplyImportRun {
  id              String  @id @default(cuid())
  officeId        String
  workspaceId     String
  connectorInstallationId String?
  createdByUserId String?
  adapter         String  @default("CSV")
  adapterVersion  String?
  status          String  @default("DRAFT") // DRAFT / VALIDATING / READY / PUBLISHED / FAILED / CANCELLED
  sourceName      String?
  sourceHash      String?
  idempotencyKey  String?
  mapping         Json?
  validation      Json?
  inputCursor     Json?
  outputCursor    Json?
  recordCounts    Json?
  traceId         String?
  errorCode       String?
  lastError       String?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectorInstallation ConnectorInstallation? @relation(fields: [connectorInstallationId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("SupplyImportRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  snapshot  SupplySnapshot?

  @@unique([officeId, idempotencyKey])
  @@index([officeId, workspaceId, status, createdAt])
  @@index([connectorInstallationId, createdAt])
  @@index([traceId])
}

// Snapshot rows and every snapshot-owned child are mutable only while DRAFT.
// The forward migration installs database triggers that reject writes after
// status becomes PUBLISHED.
model SupplySnapshot {
  id              String  @id @default(cuid())
  officeId        String
  workspaceId     String
  importRunId     String? @unique
  createdByUserId String?
  version         Int
  status          String  @default("DRAFT") // DRAFT / PUBLISHED
  schemaVersion   Int     @default(1)
  sourceHash      String?
  metadata        Json?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  office    Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importRun SupplyImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("SupplySnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  locations   SupplyLocation[]
  items       SupplyItem[]
  bomVersions SupplyBomVersion[]
  bomLines    SupplyBomLine[]
  inventory   SupplyInventoryPosition[]
  demands     SupplyDemand[]
  mediaAssets SupplyMediaAsset[]
  supplierTerms   SupplySupplierTerm[]
  fccProfiles     SupplyFccProfile[]
  planningResults SupplyPlanningResult[]
  evidence       SupplyEvidence[]
  capabilityRuns SupplyCapabilityRun[]
  decisions      SupplyDecision[]
  executionTasks SupplyExecutionTask[]

  @@unique([workspaceId, version])
  @@index([officeId, workspaceId, status, publishedAt])
  @@index([officeId, createdAt])
}

model SupplyLocation {
  id          String   @id @default(cuid())
  officeId    String
  workspaceId String
  snapshotId  String
  locationKey String
  externalId  String?
  name        String
  kind        String   @default("UNKNOWN") // FACTORY / WAREHOUSE / SUPPLIER / CUSTOMER / PORT / UNKNOWN
  addressLine String?
  city        String?
  region      String?
  postalCode  String?
  countryCode String?
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  timezone    String?
  sourceRefs  Json?

  createdAt DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  inventory   SupplyInventoryPosition[]
  demands     SupplyDemand[]
  mediaAssets SupplyMediaAsset[]
  supplierTerms SupplySupplierTerm[]

  @@unique([snapshotId, locationKey])
  @@index([officeId, workspaceId, name])
  @@index([officeId, countryCode])
}

model SupplyItem {
  id            String  @id @default(cuid())
  officeId      String
  workspaceId   String
  snapshotId    String
  itemKey       String
  externalId    String?
  sku           String?
  manufacturer  String?
  mpn           String?
  gtin          String?
  name          String
  description   String?
  category      String?
  itemType      String  @default("COMPONENT") // PRODUCT / SUBASSEMBLY / COMPONENT / MATERIAL / SERVICE
  unitOfMeasure String
  metadata      Json?
  sourceRefs    Json?

  createdAt DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  bomVersionsAsProduct SupplyBomVersion[]        @relation("SupplyBomVersionProduct")
  bomLinesAsParent     SupplyBomLine[]           @relation("SupplyBomLineParent")
  bomLinesAsComponent  SupplyBomLine[]           @relation("SupplyBomLineComponent")
  inventory            SupplyInventoryPosition[]
  demands              SupplyDemand[]
  mediaAssets          SupplyMediaAsset[]
  supplierTerms        SupplySupplierTerm[]
  fccProfile           SupplyFccProfile?

  @@unique([snapshotId, itemKey])
  @@index([officeId, workspaceId, sku])
  @@index([officeId, manufacturer, mpn])
  @@index([officeId, gtin])
}

// Durable identity decisions are workspace-scoped rather than snapshot-scoped
// so accepted ERP and manufacturer aliases can be reused by later imports.
model SupplyItemAlias {
  id               String   @id @default(cuid())
  officeId         String
  workspaceId      String
  approvedByUserId String?
  aliasType        String
  aliasValue       String
  normalizedValue  String
  canonicalItemKey String
  source           String
  confidence       Decimal? @db.Decimal(5, 4)
  isActive         Boolean  @default(true)

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  office     Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace  SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("SupplyItemAliasApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, aliasType, normalizedValue])
  @@index([officeId, workspaceId, canonicalItemKey, isActive])
}

model SupplyBomVersion {
  id            String    @id @default(cuid())
  officeId      String
  workspaceId   String
  snapshotId    String
  productItemId String
  revision      String
  status        String    @default("ACTIVE")
  sourceSystem  String?
  externalId    String?
  effectiveAt   DateTime?
  sourceRefs    Json?

  createdAt DateTime @default(now())

  office      Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace   SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot    SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productItem SupplyItem      @relation("SupplyBomVersionProduct", fields: [productItemId], references: [id], onDelete: Cascade)
  lines       SupplyBomLine[]

  @@unique([snapshotId, productItemId, revision])
  @@index([officeId, workspaceId, productItemId])
}

// Adjacency-list BOM edges keep traversal in PostgreSQL. Recursive queries can
// explode an assembly without introducing a second graph database.
model SupplyBomLine {
  id               String  @id @default(cuid())
  officeId         String
  workspaceId      String
  snapshotId       String
  bomVersionId     String
  parentItemId     String
  componentItemId  String
  lineNumber       Int
  quantity         Decimal @db.Decimal(20, 6)
  unitOfMeasure    String
  scrapRate        Decimal? @db.Decimal(9, 6)
  isOptional       Boolean @default(false)
  alternativeGroup String?
  sourceRefs       Json?

  createdAt DateTime @default(now())

  office        Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace     SupplyWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot      SupplySnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  bomVersion    SupplyBomVersion @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  parentItem    SupplyItem       @relation("SupplyBomLineParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem SupplyItem       @relation("SupplyBomLineComponent", fields: [componentItemId], references: [id], onDelete: Cascade)

  @@unique([bomVersionId, lineNumber])
  @@index([officeId, workspaceId, parentItemId])
  @@index([officeId, workspaceId, componentItemId])
  @@index([snapshotId, bomVersionId])
}

model SupplyInventoryPosition {
  id                String   @id @default(cuid())
  officeId          String
  workspaceId       String
  snapshotId        String
  positionKey       String
  itemId            String
  locationId        String
  lotNumber         String?
  unitOfMeasure     String
  quantityOnHand    Decimal? @db.Decimal(20, 6)
  quantityAllocated Decimal? @db.Decimal(20, 6)
  quantityInTransit Decimal? @db.Decimal(20, 6)
  quantityOnOrder   Decimal? @db.Decimal(20, 6)
  expectedReceiptAt DateTime?
  asOf              DateTime
  sourceRefs        Json?

  createdAt DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      SupplyItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location  SupplyLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, positionKey])
  @@index([officeId, workspaceId, itemId])
  @@index([officeId, workspaceId, locationId])
  @@index([snapshotId, asOf])
}

model SupplyDemand {
  id            String   @id @default(cuid())
  officeId      String
  workspaceId   String
  snapshotId    String
  demandKey     String
  itemId        String
  locationId    String?
  sourceType    String
  externalId    String?
  quantity      Decimal  @db.Decimal(20, 6)
  unitOfMeasure String
  dueAt         DateTime
  status        String   @default("OPEN")
  priority      Int      @default(0)
  sourceRefs    Json?

  createdAt DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      SupplyItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location  SupplyLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, demandKey])
  @@index([officeId, workspaceId, itemId, status])
  @@index([officeId, workspaceId, dueAt, status])
  @@index([snapshotId, locationId])
}

// Commercial terms are published snapshot inputs. Null commercial fields are
// deliberate unknowns and stay null through every planning result.
model SupplySupplierTerm {
  id                    String   @id @default(cuid())
  officeId              String
  workspaceId           String
  snapshotId            String
  termKey               String
  itemId                String
  facilityId            String?
  supplierKey           String
  supplierName          String
  isCurrent             Boolean  @default(false)
  unitOfMeasure         String
  currency              String?
  unitPrice             Decimal? @db.Decimal(20, 6)
  modeledFreightPerUnit Decimal? @db.Decimal(20, 6)
  evidencedDutyPerUnit  Decimal? @db.Decimal(20, 6)
  dutyEvidenceRefs      Json?
  leadTimeMinDays       Int?
  leadTimeMaxDays       Int?
  availableQuantity     Decimal? @db.Decimal(20, 6)
  availableAt           DateTime?
  evidenceRefs          Json?
  sourceRefs            Json?
  createdAt             DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      SupplyItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  facility  SupplyLocation? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, termKey])
  @@index([officeId, workspaceId, itemId, isCurrent])
  @@index([snapshotId, facilityId])
}

// A stable supplier identity accumulates across research and quote runs. It is
// a candidate until human qualification links it to canonical Company truth.
model SupplySupplierProfile {
  id                String  @id @default(cuid())
  officeId          String
  workspaceId       String
  linkedCompanyId   String?
  lastResearchRunId String?
  supplierKey       String
  normalizedName    String
  companyName       String
  website           String?
  websiteDomain     String?
  roles             Json?
  status            String  @default("CANDIDATE") // CANDIDATE / QUALIFIED / REJECTED / ARCHIVED

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office            Office                    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace         SupplyWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedCompany     Company?                  @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  lastResearchRun   SupplyCapabilityRun?      @relation("SupplySupplierLastResearchRun", fields: [lastResearchRunId], references: [id], onDelete: SetNull)
  priceObservations SupplyPriceObservation[]

  @@unique([workspaceId, supplierKey])
  @@index([officeId, workspaceId, status, lastSeenAt])
  @@index([officeId, websiteDomain])
  @@index([linkedCompanyId])
  @@index([lastResearchRunId])
}

// Profile facts are append-only observations. The current customer profile is
// a projection over Company, the latest SupplySnapshot, and these facts.
model SupplyProfileFact {
  id              String   @id @default(cuid())
  officeId        String
  workspaceId     String
  capabilityRunId String?
  evidenceId      String?
  createdByUserId String?
  subjectType     String // CUSTOMER / SUPPLIER / ITEM
  subjectRef      String
  factType        String
  value           Json
  sourceType      String
  sourceUri       String?
  contentHash     String
  observedAt      DateTime?
  capturedAt      DateTime @default(now())

  office        Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace     SupplyWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capabilityRun SupplyCapabilityRun? @relation(fields: [capabilityRunId], references: [id], onDelete: SetNull)
  evidence      SupplyEvidence?      @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("SupplyProfileFactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, contentHash])
  @@index([officeId, workspaceId, subjectType, subjectRef, capturedAt])
  @@index([capabilityRunId])
  @@index([evidenceId])
}

// Cadence and delay prevent monthly indices and delayed settlements from being
// mislabeled as live quotes.
model SupplyBenchmarkSeries {
  id            String  @id @default(cuid())
  officeId      String
  workspaceId   String
  seriesKey     String
  label         String
  materialKey   String
  provider      String
  sourceUrl     String
  cadence       String // REAL_TIME / DELAYED / DAILY / WEEKLY / MONTHLY
  delayMinutes  Int?
  currency      String?
  unitOfMeasure String?
  status        String @default("ACTIVE") // ACTIVE / PAUSED / RETIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office       Office                   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace    SupplyWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  observations SupplyPriceObservation[]

  @@unique([workspaceId, seriesKey])
  @@index([officeId, workspaceId, materialKey, status])
}

// Price observations are append-only evidence. The latest usable value is a
// query result, never a mutable field that erases prior catalog pages or quotes.
model SupplyPriceObservation {
  id                String   @id @default(cuid())
  officeId          String
  workspaceId       String
  supplierProfileId String?
  benchmarkSeriesId String?
  capabilityRunId   String?
  evidenceId        String?
  itemKey           String
  observationType   String // PUBLIC_LIST_PRICE / SUPPLIER_QUOTE / INTERNAL_PURCHASE / BENCHMARK_INDEX
  amount            Decimal  @db.Decimal(20, 6)
  currency          String
  unitOfMeasure     String
  minimumQuantity   Decimal? @db.Decimal(20, 6)
  availableQuantity Decimal? @db.Decimal(20, 6)
  sourceUrl         String
  sourceLabel       String?
  contentHash       String
  observedAt        DateTime
  validUntil        DateTime?
  capturedAt        DateTime @default(now())

  office          Office                 @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace       SupplyWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierProfile SupplySupplierProfile? @relation(fields: [supplierProfileId], references: [id], onDelete: SetNull)
  benchmarkSeries SupplyBenchmarkSeries? @relation(fields: [benchmarkSeriesId], references: [id], onDelete: SetNull)
  capabilityRun   SupplyCapabilityRun?   @relation(fields: [capabilityRunId], references: [id], onDelete: SetNull)
  evidence        SupplyEvidence?        @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, contentHash])
  @@index([officeId, workspaceId, itemKey, observedAt])
  @@index([supplierProfileId, itemKey, observedAt])
  @@index([benchmarkSeriesId, observedAt])
  @@index([capabilityRunId])
  @@index([evidenceId])
}

// Equivalence rules are explicit, approved workspace records. The engine only
// applies APPROVED rules and hashes their exact contents into its input.
model SupplyEquivalenceRule {
  id               String   @id @default(cuid())
  officeId         String
  workspaceId      String
  approvedByUserId String?
  ruleKey          String
  version          Int      @default(1)
  fromItemKey      String
  toItemKey        String?
  action           String   // REPLACE / REMOVE
  status           String   @default("DRAFT") // DRAFT / APPROVED / REVOKED
  constraints      Json?
  evidenceRefs     Json?
  ruleHash         String
  approvedAt       DateTime?
  createdAt        DateTime @default(now())

  office     Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace  SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("SupplyEquivalenceRuleApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, ruleKey, version])
  @@index([officeId, workspaceId, fromItemKey, status])
  @@index([officeId, workspaceId, toItemKey, status])
}

// FCC records describe evidence and review state. They never assert that a
// finished product passes FCC.
model SupplyFccProfile {
  id                              String   @id @default(cuid())
  officeId                        String
  workspaceId                     String
  snapshotId                      String
  itemId                          String   @unique
  moduleAuthorization             String
  moduleAuthorizationEvidenceRefs Json?
  hostIntegrationConstraints      Json?
  labeling                        String
  labelingEvidenceRefs            Json?
  rfExposure                      String
  rfExposureEvidenceRefs          Json?
  testing                         String
  testingEvidenceRefs             Json?
  testingGaps                     Json?
  reviewRequirements              Json?
  blockedReasons                  Json?
  sourceRefs                      Json?
  createdAt                       DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      SupplyItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([officeId, workspaceId, moduleAuthorization])
}

// One immutable deterministic run contains all scenario outputs, comparisons,
// recommendation order, unknowns, and the hashes needed to reproduce it.
model SupplyPlanningResult {
  id                  String   @id @default(cuid())
  officeId            String
  workspaceId         String
  snapshotId          String
  createdByUserId     String?
  engineVersion       String
  snapshotHash        String
  normalizedInputHash String
  assumptions         Json
  unknowns            Json
  evidenceReferences  Json
  output              Json
  outputHash          String
  createdAt           DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("SupplyPlanningResultCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, normalizedInputHash])
  @@index([officeId, workspaceId, createdAt])
  @@index([snapshotId, engineVersion])
  @@index([outputHash])
}

// Media is attributable operational context, not proof by itself. Snapshot-
// linked assets become immutable with the rest of the published snapshot.
model SupplyMediaAsset {
  id            String  @id @default(cuid())
  officeId      String
  workspaceId   String
  snapshotId    String?
  itemId        String?
  locationId    String?
  kind          String
  url           String
  sourceUrl     String
  sourcePageUrl String?
  creator       String?
  license       String?
  attribution   String?
  contentHash   String?
  width         Int?
  height        Int?
  isPrimary     Boolean @default(false)

  capturedAt DateTime?
  createdAt  DateTime  @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot  SupplySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      SupplyItem?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location  SupplyLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([officeId, workspaceId, kind])
  @@index([officeId, itemId, isPrimary])
  @@index([officeId, locationId, isPrimary])
  @@index([snapshotId])
}

// Evidence is append-only and independently addressable. Links below explain
// how a decision or scenario used it without rewriting the source record.
model SupplyEvidence {
  id              String    @id @default(cuid())
  officeId        String
  workspaceId     String
  snapshotId      String?
  capabilityRunId String?
  executionTaskId String?
  createdByUserId String?
  evidenceKey     String?
  kind            String
  sourceType      String
  sourceUri       String?
  sourceRecordId  String?
  sourceVersion   String?
  title           String
  excerpt         String?
  payload         Json?
  contentHash     String?
  confidence      Decimal?  @db.Decimal(5, 4)
  observedAt      DateTime?
  capturedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  office        Office                   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace     SupplyWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot      SupplySnapshot?          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  capabilityRun SupplyCapabilityRun?     @relation(fields: [capabilityRunId], references: [id], onDelete: SetNull)
  executionTask SupplyExecutionTask?     @relation(fields: [executionTaskId], references: [id], onDelete: SetNull)
  createdBy     User?                    @relation("SupplyEvidenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  decisionLinks SupplyDecisionEvidence[]
  scenarioLinks SupplyScenarioEvidence[]
  profileFacts SupplyProfileFact[]
  priceObservations SupplyPriceObservation[]

  @@unique([workspaceId, evidenceKey])
  @@index([officeId, workspaceId, kind, capturedAt])
  @@index([snapshotId, sourceType])
  @@index([capabilityRunId])
  @@index([executionTaskId])
  @@index([contentHash])
}

// A capability run is one deterministic or agent-assisted DSL invocation.
// Input and output hashes make retries and downstream evidence reproducible.
model SupplyCapabilityRun {
  id                String    @id @default(cuid())
  officeId          String
  workspaceId       String
  snapshotId        String?
  executionTaskId   String?
  invokedByUserId   String?
  parentRunId       String?
  capabilityKey     String
  capabilityVersion String
  dslName           String?
  dslVersion        String?
  status            String    @default("QUEUED") // QUEUED / RUNNING / SUCCEEDED / FAILED / CANCELLED
  input             Json
  inputHash         String
  output            Json?
  outputHash        String?
  error             Json?
  traceId           String?
  idempotencyKey    String?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office             Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace          SupplyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot           SupplySnapshot?            @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  executionTask      SupplyExecutionTask?       @relation(fields: [executionTaskId], references: [id], onDelete: Cascade)
  invokedBy          User?                      @relation("SupplyCapabilityRunInvokedBy", fields: [invokedByUserId], references: [id], onDelete: SetNull)
  parentRun          SupplyCapabilityRun?       @relation("SupplyCapabilityRunParent", fields: [parentRunId], references: [id], onDelete: Restrict)
  childRuns          SupplyCapabilityRun[]      @relation("SupplyCapabilityRunParent")
  evidence           SupplyEvidence[]
  supplierProfilesLastSeen SupplySupplierProfile[] @relation("SupplySupplierLastResearchRun")
  profileFacts       SupplyProfileFact[]
  priceObservations  SupplyPriceObservation[]
  decisionsCreated   SupplyDecision[]
  scenariosCreated   SupplyScenario[]
  comparisonsCreated SupplyScenarioComparison[]
  executionEvents    SupplyExecutionEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@index([officeId, workspaceId, capabilityKey, status, createdAt])
  @@index([snapshotId, capabilityKey])
  @@index([executionTaskId, status])
  @@index([parentRunId])
  @@index([traceId])
}

// A decision is the stable approval object. Once proposed, its hash is the
// exact scope a human approves. New analysis creates a superseding decision.
model SupplyDecision {
  id                   String    @id @default(cuid())
  officeId             String
  workspaceId          String
  snapshotId           String
  createdByUserId      String?
  createdByRunId       String?
  supersedesDecisionId String?
  decisionType         String
  subjectType          String
  subjectRef           String
  title                String
  objective            String?
  status               String    @default("DRAFT") // DRAFT / PROPOSED / APPROVED / REJECTED / SUPERSEDED / CANCELLED
  riskLevel            String    @default("MEDIUM")
  proposal             Json
  proposalHash         String?
  rationale            String?
  constraints          Json?
  idempotencyKey       String?
  finalizedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  office         Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace      SupplyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot       SupplySnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  createdBy      User?                      @relation("SupplyDecisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByRun   SupplyCapabilityRun?       @relation(fields: [createdByRunId], references: [id], onDelete: SetNull)
  supersedes     SupplyDecision?            @relation("SupplyDecisionSupersession", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy   SupplyDecision[]           @relation("SupplyDecisionSupersession")
  scenarios      SupplyScenario[]
  comparisons    SupplyScenarioComparison[]
  evidenceLinks  SupplyDecisionEvidence[]
  approvals      SupplyApproval[]
  executionTasks SupplyExecutionTask[]

  @@unique([workspaceId, idempotencyKey])
  @@index([officeId, workspaceId, status, createdAt])
  @@index([snapshotId, decisionType])
  @@index([subjectType, subjectRef])
  @@index([supersedesDecisionId])
}

model SupplyScenario {
  id                   String   @id @default(cuid())
  officeId             String
  workspaceId          String
  decisionId           String
  createdByRunId       String?
  scenarioKey          String
  name                 String
  kind                 String   @default("ALTERNATIVE") // BASELINE / PROPOSED / ALTERNATIVE
  summary              String?
  assumptions          Json
  measures             Json
  supplierPlan         Json?
  logisticsPlan        Json?
  compliancePlan       Json?
  currency             String?
  expectedCost         Decimal? @db.Decimal(20, 4)
  expectedLeadTimeDays Int?
  riskLevel            String   @default("MEDIUM")
  feasible             Boolean?
  rank                 Int?
  createdAt            DateTime @default(now())

  office               Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace            SupplyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision             SupplyDecision             @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  createdByRun         SupplyCapabilityRun?       @relation(fields: [createdByRunId], references: [id], onDelete: SetNull)
  baselineComparisons  SupplyScenarioComparison[] @relation("SupplyScenarioComparisonBaseline")
  candidateComparisons SupplyScenarioComparison[] @relation("SupplyScenarioComparisonCandidate")
  evidenceLinks        SupplyScenarioEvidence[]
  executionTasks       SupplyExecutionTask[]

  @@unique([decisionId, scenarioKey])
  @@index([officeId, workspaceId, decisionId, rank])
  @@index([createdByRunId])
}

model SupplyScenarioComparison {
  id                  String   @id @default(cuid())
  officeId            String
  workspaceId         String
  decisionId          String
  baselineScenarioId  String
  candidateScenarioId String
  createdByRunId      String?
  measures            Json
  costDelta           Decimal? @db.Decimal(20, 4)
  leadTimeDeltaDays   Int?
  riskDelta           String?
  verdict             String?
  rationale           String?
  createdAt           DateTime @default(now())

  office            Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace         SupplyWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision          SupplyDecision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  baselineScenario  SupplyScenario       @relation("SupplyScenarioComparisonBaseline", fields: [baselineScenarioId], references: [id], onDelete: Cascade)
  candidateScenario SupplyScenario       @relation("SupplyScenarioComparisonCandidate", fields: [candidateScenarioId], references: [id], onDelete: Cascade)
  createdByRun      SupplyCapabilityRun? @relation(fields: [createdByRunId], references: [id], onDelete: SetNull)

  @@unique([decisionId, baselineScenarioId, candidateScenarioId])
  @@index([officeId, workspaceId, decisionId])
  @@index([createdByRunId])
}

model SupplyDecisionEvidence {
  id          String   @id @default(cuid())
  officeId    String
  workspaceId String
  decisionId  String
  evidenceId  String
  usage       String   @default("SUPPORTS") // SUPPORTS / CONTRADICTS / CONSTRAINT / ASSUMPTION
  note        String?
  createdAt   DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  SupplyDecision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  evidence  SupplyEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([decisionId, evidenceId, usage])
  @@index([officeId, workspaceId, decisionId])
  @@index([evidenceId])
}

model SupplyScenarioEvidence {
  id          String   @id @default(cuid())
  officeId    String
  workspaceId String
  scenarioId  String
  evidenceId  String
  usage       String   @default("SUPPORTS")
  note        String?
  createdAt   DateTime @default(now())

  office    Office          @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace SupplyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scenario  SupplyScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  evidence  SupplyEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, evidenceId, usage])
  @@index([officeId, workspaceId, scenarioId])
  @@index([evidenceId])
}

// Approvals bind a human decision to the exact proposal or task input hash.
// Terminal approval records cannot be rewritten by normal application code.
model SupplyApproval {
  id                String    @id @default(cuid())
  officeId          String
  workspaceId       String
  decisionId        String?
  executionTaskId   String?
  requestedByUserId String?
  decidedByUserId   String?
  status            String    @default("PENDING") // PENDING / APPROVED / REJECTED / CANCELLED / EXPIRED
  requiredRole      String?
  scopeHash         String
  requestReason     String?
  requestContext    Json?
  decisionNote      String?
  idempotencyKey    String?
  requestedAt       DateTime  @default(now())
  decidedAt         DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  office        Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace     SupplyWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision      SupplyDecision?      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  executionTask SupplyExecutionTask? @relation(fields: [executionTaskId], references: [id], onDelete: Cascade)
  requestedBy   User?                @relation("SupplyApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy     User?                @relation("SupplyApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([officeId, workspaceId, status, requestedAt])
  @@index([decisionId, status])
  @@index([executionTaskId, status])
}

// Execution task stores the intended side effect. Execution events are the
// append-only ledger of attempts, external acknowledgements, and outcomes.
model SupplyExecutionTask {
  id               String    @id @default(cuid())
  officeId         String
  workspaceId      String
  snapshotId       String?
  decisionId       String?
  scenarioId       String?
  createdByUserId  String?
  parentTaskId     String?
  taskKey          String
  taskType         String
  capabilityKey    String?
  status           String    @default("PLANNED") // PLANNED / BLOCKED / READY / RUNNING / SUCCEEDED / FAILED / CANCELLED
  requiresApproval Boolean   @default(true)
  input            Json
  inputHash        String
  result           Json?
  resultHash       String?
  error            Json?
  externalSystem   String?
  externalRef      String?
  idempotencyKey   String?
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  office         Office                 @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace      SupplyWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshot       SupplySnapshot?        @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  decision       SupplyDecision?        @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  scenario       SupplyScenario?        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdBy      User?                  @relation("SupplyExecutionTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parentTask     SupplyExecutionTask?   @relation("SupplyExecutionTaskParent", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks     SupplyExecutionTask[]  @relation("SupplyExecutionTaskParent")
  approvals      SupplyApproval[]
  capabilityRuns SupplyCapabilityRun[]
  evidence       SupplyEvidence[]
  events         SupplyExecutionEvent[]

  @@unique([workspaceId, taskKey])
  @@unique([workspaceId, idempotencyKey])
  @@index([officeId, workspaceId, status, scheduledFor])
  @@index([snapshotId, status])
  @@index([decisionId, scenarioId])
  @@index([parentTaskId])
  @@index([externalSystem, externalRef])
}

model SupplyExecutionEvent {
  id              String   @id @default(cuid())
  officeId        String
  workspaceId     String
  executionTaskId String
  capabilityRunId String?
  actorUserId     String?
  sequence        Int
  eventType       String
  status          String?
  message         String?
  payload         Json?
  payloadHash     String?
  idempotencyKey  String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  office        Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  workspace     SupplyWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionTask SupplyExecutionTask  @relation(fields: [executionTaskId], references: [id], onDelete: Cascade)
  capabilityRun SupplyCapabilityRun? @relation(fields: [capabilityRunId], references: [id], onDelete: SetNull)
  actor         User?                @relation("SupplyExecutionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([executionTaskId, sequence])
  @@unique([executionTaskId, idempotencyKey])
  @@index([officeId, workspaceId, occurredAt])
  @@index([capabilityRunId])
}
