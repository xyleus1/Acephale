+    helper = ROOT / 'stage_completed_inputs_v2.py'
+    contract.require(approved.get('independentReviewPassed') is True
+        and approved.get('executionSourceCommit') == contract.EXECUTION_SOURCE
+        and contract.sha(helper) == approved['stagingHelperSha256'],
+        'Previously approved dataset archive and staging verifier required')
+    spec = importlib.util.spec_from_file_location('main_dataset_staging_verifier', helper)
+    staging = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(staging)
+    _, inventory = staging.archive_checked(approved['datasetArchive'],
+        approved['datasetInventory']['sha256'], weights=False)
+    local = staging.pinned(approved['datasetInventory'])
+    contract.require(contract.read(local) == inventory, 'Local inventory differs from the approved archive envelope')
+    return local, inventory
 
 
