+class SupervisorStopped(BaseException):
+    """An external stop must bypass ordinary per-condition failure handling."""
+
+
+def run_conditions(rows, run, complete, abort):
+    """Run the three isolated conditions once; retain independent failures.
+
+    The shared Bootstrap owns and drains each child process. An external stop
+    sets its abort event before joining workers, so waiting does not outlive the
+    original deadline. A condition failure does not discard its siblings.
+    """
+    require([row['id'] for row in rows] == list(CONDITIONS), 'Exact three conditions required')
+    failures = {}
+    stop_handlers = {}
+    pool = ThreadPoolExecutor(max_workers=3, thread_name_prefix='replay-condition')
+    try:
+        futures = {pool.submit(run, row): row for row in rows}
+        for future in as_completed(futures):
+            row = futures[future]
+            try:
+                complete(row, future.result())
+            except Exception as error:
+                failures[row['id']] = {'type': type(error).__name__, 'message': str(error)}
+    except BaseException:
+        # Repeated signals cannot interrupt the owned worker drain. Restore the
+        # caller's handlers only after every child owner has returned.
+        if threading.current_thread() is threading.main_thread():
+            for name in ('SIGTERM', 'SIGINT', 'SIGALRM'):
+                number = getattr(signal, name, None)
+                if number is not None:
+                    stop_handlers[number] = signal.getsignal(number)
+                    signal.signal(number, signal.SIG_IGN)
+        abort()
+        raise
+    finally:
+        try:
+            pool.shutdown(wait=True, cancel_futures=True)
+        finally:
+            for number, handler in stop_handlers.items():
+                signal.signal(number, handler)
+    return {name: failures[name] for name in CONDITIONS if name in failures}
