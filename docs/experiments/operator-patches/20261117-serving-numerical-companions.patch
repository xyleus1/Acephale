+"""Private provenance companions for the observed numerical serving policy.
+
+Frozen scientific manifests remain byte-for-byte outputs of their original
+writers. These companions bind those outputs to the separately observed recipe.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+
+from acephale.contracts_v1 import hash_v1
+
+SOURCE = '5a36a8b3835820fe65b3615ead31fb6fb7bc9672'
+OCCURRENCES = ('seed17-01', 'seed29-01', 'seed17-02', 'seed29-02')
+
+
+def require(value, message):
+    if not value:
+        raise ValueError(message)
+
+
+def sha(path):
+    path = Path(path)
+    require(path.is_file() and not path.is_symlink(), 'Regular numerical provenance input required')
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def read(path):
+    sha(path)
+    return json.loads(Path(path).read_text(encoding='utf-8'))
+
+
+def sealed(value):
+    return {**value, 'contentHash': hash_v1(value)}
+
+
+def verified(value):
+    require(value.get('contentHash') == hash_v1({k: v for k, v in value.items() if k != 'contentHash'}),
+            'Numerical provenance content hash changed')
+    return value
+
+
+def write(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open('x', encoding='utf-8') as stream:
+        json.dump(value, stream, indent=2, allow_nan=False)
+        stream.write('\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def archived(root, occurrence, remote):
+    base = PurePosixPath('/srv/acephale/artifacts/serving-' + occurrence)
+    name = PurePosixPath(remote)
+    require(name.is_absolute() and '..' not in name.parts and name.is_relative_to(base),
+            'Numerical evidence must be inside the exact serving archive')
+    local = Path(root) / f'serving-{occurrence}-stage/verified/serving' / str(name.relative_to(base))
+    require(not any(p.is_symlink() for p in [local, *local.parents]), 'Symlink numerical evidence forbidden')
+    return local
+
+
+def load(root, occurrence):
+    """Read only the actual completed configured occurrence and its exact files."""
+    import serving_precision as precision
+    require(occurrence in OCCURRENCES, 'Declared occurrence required')
+    root = Path(root)
+    output = root / f'serving-{occurrence}-stage/verified/serving'
+    completed_path = output / 'serving-completed.json'
+    completed = verified(read(completed_path))
+    owner = read(root / 'remote-owner-config.json')
+    require(completed.get('completed') is True and completed['sourceCommit'] == SOURCE
+            and completed['occurrenceId'] == occurrence
+            and all(completed[k] == owner[k] for k in ('leaseId', 'instanceId')),
+            'Completed numerical recipe belongs to another owner')
+    paths = {}
+    for name in ('numericalPolicy', 'effectiveCompose', 'tunedConfig', 'numericalAttestation', 'diagnosticReceipt'):
+        paths[name] = archived(root, occurrence, completed[name + 'Path'])
+        require(sha(paths[name]) == completed[name + 'Sha256'], 'Numerical recipe file hash changed: ' + name)
+    policy_document = verified(read(paths['numericalPolicy']))
+    policy = {k: v for k, v in policy_document.items() if k != 'contentHash'}
+    require(policy == precision.numerical_policy() and policy_document['contentHash'] == completed['numericalPolicyHash'],
+            'Numerical policy differs from the exact prospective policy')
+    require(paths['tunedConfig'].read_bytes() == precision.configuration_bytes(), 'Configured SHRINK bytes differ')
+    attestation = read(paths['numericalAttestation'])
+    diagnostic = read(paths['diagnosticReceipt'])
+    scope = attestation['scope']
+    require(all(scope[k] == owner[k] for k in ('leaseId', 'instanceId', 'hardDeadline'))
+            and scope['occurrenceId'] == occurrence, 'Numerical attestation scope differs')
+    require(attestation == precision.numerical_attestation(scope, completed['numericalPolicyHash'],
+        attestation['observations'], completed['effectiveComposeSha256'], completed['tunedConfigSha256'],
+        completed['actorContainerId']), 'Numerical attestation is detached from the completed recipe')
+    reports = {}
+    for variant in ('baseline', 'configured'):
+        path = archived(root, occurrence, diagnostic[variant + 'ReportPath'])
+        require(sha(path) == diagnostic[variant + 'ReportSha256'], 'Diagnostic response report changed')
+        paths[variant + 'Report'] = path
+        reports[variant] = read(path)
+    expected_diagnostic = precision.diagnostic_receipt(scope, completed['numericalPolicyHash'],
+        reports['baseline'], reports['configured'], diagnostic['baselineReportPath'],
+        diagnostic['configuredReportPath'], lambda path: sha(archived(root, occurrence, str(path))))
+    require(diagnostic == expected_diagnostic, 'Fixed numerical diagnostic commitment changed')
+    require(attestation['configuredPredictorContainerId'] == diagnostic['configuredPredictorContainerId']
+            == completed['predictorContainerId'], 'Baseline or another predictor cannot admit science')
+    inventory_path = output / 'inventory-after/inventory-evidence.json'
+    deployment_path = output / 'inventory-after/observed-deployment.json'
+    require(sha(inventory_path) == completed['inventorySha256']
+            and sha(deployment_path) == completed['deploymentSha256'], 'Frozen inventory commitment changed')
+    inventory = read(inventory_path)
+    predictor = inventory['containers']['predictor']
+    require(predictor['id'] == completed['predictorContainerId']
+            and inventory['containers']['actor']['id'] == completed['actorContainerId'],
+            'Configured predictor differs from frozen post-qualification inventory')
+    for stage in ('configuredBefore', 'configuredAfter'):
+        seen = attestation['observations'][stage]['inspection']
+        require(seen['containerId'] == predictor['id'] and seen['imageId'] == predictor['imageId']
+                and seen['startedAt'] == predictor['startedAt'], 'Configured process lifetime differs')
+    before = attestation['observations']['configuredBefore']['inspection']
+    after = attestation['observations']['configuredAfter']['inspection']
+    require(all(before[k] == after[k] for k in ('environmentSha256', 'mountsSha256', 'tunedMount', 'tunedEnvironment')),
+            'Configured recipe changed during qualification')
+    proof_path = root / f'serving-{occurrence}-stage/verified/qualification/native-lora-proof.json'
+    require(sha(proof_path) == completed['proofSha256']
+            and hash_v1(read(proof_path)['response']) == diagnostic['selectedResponseHash'],
+            'Original proof must use predetermined configured response zero')
+    runtime_compose = PurePosixPath(completed['effectiveComposeRuntimePath'])
+    require(runtime_compose == PurePosixPath('/srv/acephale/training-source-5a36a8b3/infra/acephale-infra-v1') /
+            f'compose.resolved.serving-{occurrence}-splitk1.json', 'Unexpected effective runtime compose path')
+    files = {str(path.resolve()): sha(path) for path in [completed_path, inventory_path, deployment_path, proof_path, *paths.values()]}
+    return sealed({'kind': 'acephale-serving-numerical-policy-binding-v1', 'sourceCommit': SOURCE,
+        'leaseId': owner['leaseId'], 'instanceId': owner['instanceId'], 'hardDeadline': owner['hardDeadline'],
+        'occurrenceId': occurrence, 'predictorContainerId': predictor['id'], 'predictorStartedAt': predictor['startedAt'],
+        'numericalPolicyHash': completed['numericalPolicyHash'], 'effectiveComposeSha256': completed['effectiveComposeSha256'],
+        'tunedConfigSha256': completed['tunedConfigSha256'], 'numericalAttestationSha256': completed['numericalAttestationSha256'],
+        'diagnosticReceiptSha256': completed['diagnosticReceiptSha256'],
+        'baseSourceComposeSha256': inventory['sourceComposeSha256'],
+        'baseRecipeIsFrozen': True, 'effectiveRecipeIncludesNumericalOverlay': True,
+        'frozenManifestSchemaChanged': False, 'files': files,
+        'remote': {'numericalPolicyHash': completed['numericalPolicyHash'],
+            'effectiveComposePath': str(runtime_compose), 'effectiveComposeSha256': completed['effectiveComposeSha256'],
+            'tunedConfigPath': completed['tunedConfigPath'], 'tunedConfigSha256': completed['tunedConfigSha256'],
+            'numericalPolicyPath': completed['numericalPolicyPath'], 'numericalPolicySha256': completed['numericalPolicySha256'],
+            'predictorContainerId': predictor['id'], 'environmentSha256': after['environmentSha256'],
+            'mountsSha256': after['mountsSha256'], 'tunedMount': after['tunedMount'],
+            'tunedEnvironment': after['tunedEnvironment']}})
+
+
+def verify_files(value):
+    verified(value)
+    require(value['files'] and all(sha(path) == expected for path, expected in value['files'].items()),
+            'Numerical companion references changed')
+    return value
+
+
+def check_observation(binding, observation):
+    seen = observation.get('numericalPolicyObservation', {})
+    require(observation.get('servingOwnershipConfirmed') is True
+            and all(observation.get(k) == binding[k] for k in ('leaseId', 'instanceId'))
+            and seen.get('verified') is True and seen.get('changesMade') is False
+            and all(seen.get(k) == binding[k] for k in ('numericalPolicyHash', 'effectiveComposeSha256',
+                                                     'tunedConfigSha256', 'predictorContainerId')),
+            'Fresh configured numerical-policy observation required')
+
+
+def companion(root, occurrence, label, paths, *, observation=None, parents=()):
+    binding = load(root, occurrence)
+    if observation is not None:
+        check_observation(binding, observation)
+    files = {str(Path(path).resolve()): sha(path) for path in paths}
+    parent_refs = []
+    for path in parents:
+        previous = check_companion(root, occurrence, path)
+        require(previous['numericalPolicyHash'] == binding['numericalPolicyHash']
+                and previous['tunedConfigSha256'] == binding['tunedConfigSha256'],
+                'Calibration/replay numerical policy differs from current serving')
+        parent_refs.append({'path': str(Path(path).resolve()), 'sha256': sha(path), 'contentHash': previous['contentHash']})
+    result = sealed({'kind': 'acephale-scientific-numerical-policy-companion-v1', 'stage': label,
+        'sourceCommit': SOURCE, 'occurrenceId': occurrence, 'leaseId': binding['leaseId'], 'instanceId': binding['instanceId'],
+        'numericalPolicyHash': binding['numericalPolicyHash'], 'tunedConfigSha256': binding['tunedConfigSha256'],
+        'servingBindingHash': binding['contentHash'], 'servingBinding': binding, 'files': files,
+        'parents': parent_refs, 'frozenScientificOutputsModified': False,
+        'observation': observation, 'diagnosticResponsesUsedAsReplayOrCalibration': False})
+    path = Path(root) / 'downstream' / occurrence / 'numerical-policy' / (label + '.json')
+    write(path, result)
+    return path
+
+
+def check_companion(root, occurrence, path, *, seen=None):
+    path = Path(path).resolve()
+    seen = set() if seen is None else set(seen)
+    require(path not in seen and len(seen) < 12, 'Cyclic or oversized numerical provenance chain')
+    seen.add(path)
+    value = verify_files(read(path))
+    current = load(root, occurrence)
+    require(value.get('kind') == 'acephale-scientific-numerical-policy-companion-v1'
+            and value.get('stage') == path.stem
+            and path.parent == (Path(root)/'downstream'/value['occurrenceId']/'numerical-policy').resolve(),
+            'Numerical companion kind or actual stage path changed')
+    require(value['numericalPolicyHash'] == current['numericalPolicyHash']
+            and value['tunedConfigSha256'] == current['tunedConfigSha256']
+            and value['occurrenceId'][:6] == occurrence[:6]
+            and all(value[k] == current[k] for k in ('leaseId', 'instanceId')),
+            'Scientific companion belongs to another effective numerical policy')
+    embedded = verify_files(value['servingBinding'])
+    require(embedded.get('kind') == 'acephale-serving-numerical-policy-binding-v1'
+            and value['servingBindingHash'] == embedded['contentHash']
+            and all(value[k] == embedded[k] for k in ('occurrenceId', 'leaseId', 'instanceId',
+                                                     'numericalPolicyHash', 'tunedConfigSha256')),
+            'Scientific companion is detached from its serving binding')
+    base = Path(root)/'downstream'/value['occurrenceId']
+    expected = None
+    if value['stage'] == 'qualified':
+        expected = [base/'qualified'/name for name in
+            ('manifest.json', 'profile.json', 'native.json', 'guard.json', 'deployment.json', 'inventory.json', 'preparation.json')]
+    elif value['stage'] == 'replay':
+        expected = [base/'replay/local-export-verification.json', *[base/'replay/verified/output'/condition/name
+            for condition in ('neutral-fixed', 'goals-selected', 'goals-fixed') for name in ('manifest.json', 'closed-payload.json')]]
+    elif value['stage'] == 'calibration':
+        expected = [base/'analysis'/name for name in
+            ('commands.json', 'probability-calibration/calibration.json', 'goal-reliability/goal-reliability.json')]
+    if expected is not None:
+        require(set(value['files']) == {str(p.resolve()) for p in expected}, 'Numerical companion stage artifacts differ')
+    for parent in value['parents']:
+        require(sha(parent['path']) == parent['sha256'], 'Numerical companion parent changed')
+        prior = check_companion(root, occurrence, parent['path'], seen=seen)
+        require(prior['contentHash'] == parent['contentHash']
+                and prior['numericalPolicyHash'] == current['numericalPolicyHash'], 'Numerical parent identity changed')
+    return value
