+def acknowledgement_until(context, publication):
+    """Bound verification of an already timely child publication by its freshness."""
+    lease = context['lease']
+    effective = lease['setupDeadline'] if context['mode'] == 'active_lease' else context['qualificationDeadline']
+    return min(publication['ownerHeartbeatAt'] + 60, effective - 15, lease['deadline'] - 15)
