+
+def tuned_configuration():
+    # Nearest-key lookup preserves the integer M<128 boundary. The standard
+    # num_slices lookup is exact; Qwen3.5 includes four physical GDN slices.
+    return {'1': {str(s): {str(m): {str(k): {'16': leaf(m, 1)}
+        for k in (1024, 2048, 3584)} for m in (1, 127, 128)} for s in (1, 2, 3, 4)}}
+
+
+def configuration_bytes():
+    return (json.dumps(tuned_configuration(), sort_keys=True, indent=2) + '\n').encode()
