+def diagnostic_receipt(scope, policy_hash, baseline, configured, baseline_path, configured_path, sha):
+    for label, value in (('baseline', baseline), ('split_k1', configured)):
+        require(value['variant'] == label and value['fixedRequestCount'] == 3
+                and value['selectedProofIndex'] == 0 and len(value['rows']) == 3,
