+    configured_id = observations['configuredBefore']['inspection']['containerId']
+    require(baseline_id == observations['baselineAfter']['inspection']['containerId']
+        and configured_id == observations['configuredAfter']['inspection']['containerId']
+        and baseline_id != configured_id, 'Exact two predictor process lifetimes required')
+    require(all(observations[variant + 'Before']['inspection']['startedAt'] ==
+                observations[variant + 'After']['inspection']['startedAt']
+                for variant in ('baseline', 'configured')), 'Predictor process restarted during a fixed variant')
+    return {'kind': 'acephale-predictor-numerical-attestation-v1', 'scope': scope,
+        'numericalPolicyHash': policy_hash, 'effectiveComposeSha256': effective_compose_sha,
+        'tunedConfigSha256': config_sha, 'baselinePredictorContainerId': baseline_id,
+        'configuredPredictorContainerId': configured_id, 'actorContainerId': actor_id,
+        'actorUnchanged': True, 'observations': observations,
+        'resolverEvidenceKind': 'same-image-container-exec-standard-resolver',
+        'engineWorkerKernelTraceClaimed': False}
