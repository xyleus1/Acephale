+
+def check_inspect(row, baseline, folder, config_sha, *, configured):
+    require(row['Config']['Cmd'] == baseline['Config']['Cmd'] and row['Image'] == baseline['Image'],
+            'Predictor command or image changed')
+    before_env = baseline['Config'].get('Env', [])
+    after_env = row['Config'].get('Env', [])
+    require(len(before_env) == len(set(before_env)) and len(after_env) == len(set(after_env)),
+            'Duplicate container environment entry')
+    require(not any(v.startswith('VLLM_TUNED_CONFIG_FOLDER=') for v in before_env),
+            'Baseline container already uses tuned configuration')
+    expected = 'VLLM_TUNED_CONFIG_FOLDER=' + CONTAINER_FOLDER
+    require(set(after_env) == set(before_env) | ({expected} if configured else set()),
+            'Unexpected predictor environment change')
+    mounts = [v for v in row.get('Mounts', []) if v.get('Destination') == CONTAINER_FOLDER]
+    require(len(mounts) == (1 if configured else 0), 'Unexpected tuned mount count')
+    if configured:
+        require(mounts[0].get('RW') is False and mounts[0].get('Type') == 'bind'
+                and Path(mounts[0]['Source']) == Path(folder), 'Exact readonly tuned mount required')
+    remaining = [v for v in row.get('Mounts', []) if v.get('Destination') != CONTAINER_FOLDER]
+    require(remaining == baseline.get('Mounts', []), 'Original model or other mounts changed')
+    require(row['State']['Running'] is True, 'Observed predictor must be running')
+    canonical_sha = lambda value: hashlib.sha256(rfc8785.dumps(value)).hexdigest()
+    return {'containerId': row['Id'], 'imageId': row['Image'], 'configured': configured,
+            'startedAt': row['State']['StartedAt'], 'environmentSha256': canonical_sha(sorted(after_env)),
+            'mountsSha256': canonical_sha(row.get('Mounts', [])), 'commandSha256': canonical_sha(row['Config']['Cmd']),
+            'configSha256': config_sha if configured else None,
+            'tunedEnvironment': expected if configured else None,
+            'tunedMount': mounts[0] if mounts else None,
+            'originalCommandAndEnvironmentAndMountsPreserved': True}
+
+
+def resolver_script(config_sha, *, configured):
