+/** Fixed three-request diagnostic per variant; original numerical gate unchanged. */
+import assert from 'node:assert/strict';
+import {mkdir,readFile,writeFile} from 'node:fs/promises';
+import {pathToFileURL} from 'node:url';
+import {parityRequest,validateParityBinding,verifyParityResponse} from './serving-parity.mjs';
+
+export function requestPlan(scope, variant, hash) {
+  assert(['baseline','split_k1'].includes(variant));
+  assert(typeof scope.instanceId==='string' && /^[a-f0-9]{32}$/.test(scope.instanceId));
+  assert(typeof scope.leaseId==='string' && typeof scope.occurrenceId==='string');
+  assert(scope.predictorContainerId && Number.isFinite(scope.hardDeadline));
+  const salt = label => hash({kind:'acephale-fixed-parity-cache-domain-v1',
+    instanceId:scope.instanceId,leaseId:scope.leaseId,occurrenceId:scope.occurrenceId,
+    predictorContainerId:scope.predictorContainerId,variant,label});
+  return [
+    {index:0,cacheIntent:'cold_requested',cacheSalt:salt('A')},
+    {index:1,cacheIntent:'warm_requested',cacheSalt:salt('A')},
+    {index:2,cacheIntent:'cold_requested',cacheSalt:salt('B')},
+  ];
+}
+
+function numeric(response, probe) {
+  const row=response.choices[0], values=row.logprobs.top_logprobs[0];
+  const zero=values['token_id:'+probe.binaryTokenIds.zero], one=values['token_id:'+probe.binaryTokenIds.one];
+  assert(Number.isFinite(zero) && Number.isFinite(one));
+  const m=Math.max(zero,one), probability=Math.exp(one-m)/(Math.exp(zero-m)+Math.exp(one-m));
+  return {observedLogprobs:{zero,one},observedConditionalOneProbability:probability,
+    conditionalProbabilityDifference:Math.abs(probability-probe.referenceConditionalOneProbability)};
+}
+
+export async function runDiagnostic({binding,sourceCommit,scope,variant,hash,request,write,clock=Date.now,deadline}) {
+  const identity=validateParityBinding(binding,sourceCommit,hash);
+  assert.equal(scope.predictorContainerId,identity.containerId);
+  assert.equal(scope.predictorStartedAt,identity.containerStartedAt);
+  assert(Number.isFinite(deadline) && deadline<=scope.hardDeadline*1000);
+  const plan=requestPlan(scope,variant,hash), rows=[];
+  const bounded=()=>assert(clock()<deadline-5000,'Original diagnostic deadline reached');
+  await write('plan.json',{kind:'acephale-fixed-serving-parity-plan-v1',scope,variant,
+    bindingHash:hash(binding),plan,originalGate:binding.probe.gate,selectedProofIndex:0});
+  for(const item of plan) {
+    bounded();
+    const body={...parityRequest(binding.artifact,binding.probe),cache_salt:item.cacheSalt};
+    await write(`request-${item.index}.json`,body);
+    const probeStartedAtUnixMs=clock();
+    const response=await request(body);
+    const probeCompletedAtUnixMs=clock();
+    await write(`response-${item.index}.json`,response);
+    bounded();
+    const timing={probeStartedAtUnixMs,probeCompletedAtUnixMs};
+    let receipt=null,gateFailure=null;
+    try {receipt=verifyParityResponse(response,binding.artifact,binding.probe,identity,hash,timing);}
+    catch(error) {
+      // Only the existing final numeric gate can be observed as a failed arm.
+      // All identity/token/model/HTTP/nonfinite/structural failures terminate.
+      if(error?.code!=='ERR_ASSERTION' || error.message!=='Cross-engine binary probability gate failed') throw error;
+      gateFailure=error.message;
+    }
+    const cached=response.usage?.prompt_tokens_details?.cached_tokens;
+    if(cached!==undefined && cached!==null) assert(Number.isSafeInteger(cached)&&cached>=0&&cached<=response.usage.prompt_tokens);
+    const row={...item,...timing,responseHash:hash(response),passed:receipt!==null,receipt,gateFailure,
+      ...numeric(response,binding.probe),cachedTokens:Number.isSafeInteger(cached)&&cached>=0?cached:null,
+      cacheTokenCountObserved:Number.isSafeInteger(cached)&&cached>=0,
+      responseFile:`response-${item.index}.json`,requestHash:hash(body)};
+    rows.push(row);await write(`result-${item.index}.json`,row);
+  }
+  const result={kind:'acephale-fixed-serving-parity-diagnostic-v1',scope,variant,
+    bindingHash:hash(binding),sourceCommit,plan,rows,allPassed:rows.every(row=>row.passed),
+    fixedRequestCount:3,selectedProofIndex:0,originalGate:binding.probe.gate,
+    deterministicExecutionProven:false,benchmarkAccuracyMeasured:false};
+  await write('diagnostic.json',result);
+  return result;
+}
+
+export async function loadFixedProof(path,binding,sourceCommit,hash) {
+  const report=JSON.parse(await readFile(path,'utf8'));
+  assert.equal(report.kind,'acephale-fixed-serving-parity-diagnostic-v1');
+  assert.equal(report.variant,'split_k1');assert.equal(report.allPassed,true);
+  assert.equal(report.fixedRequestCount,3);assert.equal(report.selectedProofIndex,0);
+  assert.equal(report.bindingHash,hash(binding));assert.equal(report.sourceCommit,sourceCommit);
+  assert.deepEqual(report.originalGate,binding.probe.gate);
+  assert.deepEqual(report.plan,requestPlan(report.scope,'split_k1',hash));
+  assert.equal(report.rows.length,3);
+  const declared=JSON.parse(await readFile(new URL('plan.json',pathToFileURL(path)),'utf8'));
+  assert.deepEqual(declared,{kind:'acephale-fixed-serving-parity-plan-v1',scope:report.scope,variant:report.variant,
+    bindingHash:report.bindingHash,plan:report.plan,originalGate:report.originalGate,selectedProofIndex:0});
+  const identity=validateParityBinding(binding,sourceCommit,hash);
+  assert.equal(report.scope.predictorContainerId,identity.containerId);
+  assert.equal(report.scope.predictorStartedAt,identity.containerStartedAt);
+  let selected,previousEnd=Date.parse(identity.inventoryObservedAt);
+  for(let index=0;index<3;index++) {
+    const row=report.rows[index];assert.equal(row.index,index);assert.equal(row.passed,true);
+    assert.deepEqual({index:row.index,cacheIntent:row.cacheIntent,cacheSalt:row.cacheSalt},report.plan[index]);
+    assert.equal(row.responseFile,`response-${index}.json`);
+    assert(Number.isSafeInteger(row.probeStartedAtUnixMs)&&Number.isSafeInteger(row.probeCompletedAtUnixMs));
+    assert(previousEnd<=row.probeStartedAtUnixMs&&row.probeStartedAtUnixMs<=row.probeCompletedAtUnixMs
+      &&row.probeCompletedAtUnixMs<=report.scope.hardDeadline*1000);
+    previousEnd=row.probeCompletedAtUnixMs;
+    const request=JSON.parse(await readFile(new URL(`request-${index}.json`,pathToFileURL(path)),'utf8'));
+    assert.deepEqual(request,{...parityRequest(binding.artifact,binding.probe),cache_salt:report.plan[index].cacheSalt});
+    assert.equal(hash(request),row.requestHash);
+    const response=JSON.parse(await readFile(new URL(row.responseFile,pathToFileURL(path)),'utf8'));
+    assert.equal(hash(response),row.responseHash);
+    const receipt=verifyParityResponse(response,binding.artifact,binding.probe,identity,hash,
+      {probeStartedAtUnixMs:row.probeStartedAtUnixMs,probeCompletedAtUnixMs:row.probeCompletedAtUnixMs});
+    assert.deepEqual(receipt,row.receipt);
+    if(index===0) selected={response,probeStartedAtUnixMs:row.probeStartedAtUnixMs,probeCompletedAtUnixMs:row.probeCompletedAtUnixMs};
+  }
+  return selected;
+}
+
+if(process.argv[1] && import.meta.url===pathToFileURL(process.argv[1]).href) {
+  const [configurationPath]=process.argv.slice(2);
+  const config=JSON.parse(await readFile(configurationPath,'utf8'));
+  assert(config.output.startsWith('/artifacts/')&&!config.output.split('/').includes('..'));
+  const {hash}=await import('/app/src/lib/acephale/canonical.ts');
+  const binding=JSON.parse(await readFile(config.bindingPath,'utf8'));
+  await mkdir(config.output,{recursive:false});
+  const write=async(name,value)=>writeFile(config.output+'/'+name,JSON.stringify(value,null,2)+'\n',{flag:'wx',mode:0o600});
+  const request=async(body)=>{
+    const remaining=Math.min(90000,config.deadline*1000-Date.now()-5000);
+    assert(remaining>0);
+    const response=await fetch('http://predictor:8000/v1/completions',{method:'POST',
+      headers:{'content-type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(Math.floor(remaining))});
+    assert(response.ok,`Diagnostic HTTP status ${response.status}`);
+    return response.json();
+  };
+  await runDiagnostic({binding,sourceCommit:config.sourceCommit,scope:config.scope,
+    variant:config.variant,hash,request,write,deadline:config.deadline*1000});
+}
