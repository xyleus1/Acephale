+                'Diagnostic original scope changed')
+        require(value['originalGate'] == numerical_policy()['originalGate'], 'Original gate changed')
+        require(all(row['index'] == i and (row['passed'] is True or
+                    row['gateFailure'] == 'Cross-engine binary probability gate failed')
+                    for i, row in enumerate(value['rows'])), 'Non-numerical diagnostic failure cannot continue')
+    require(configured['allPassed'] is True and all(row['passed'] is True for row in configured['rows']),
+            'Every configured numerical result must pass the original gate')
+    return {'kind': 'acephale-fixed-numerical-diagnostic-receipt-v1', 'scope': scope,
+        'numericalPolicyHash': policy_hash, 'baselineReportPath': str(baseline_path),
+        'baselineReportSha256': sha(baseline_path), 'configuredReportPath': str(configured_path),
+        'configuredReportSha256': sha(configured_path), 'baselineAllPassed': baseline['allPassed'],
+        'configuredAllPassed': True, 'requestsPerVariant': 3, 'selectedProofIndex': 0,
+        'configuredPredictorContainerId': configured['scope']['predictorContainerId'],
+        'selectedResponseHash': configured['rows'][0]['responseHash'],
+        'baselineFailuresDoNotAdmitServing': True, 'deterministicExecutionProven': False}
