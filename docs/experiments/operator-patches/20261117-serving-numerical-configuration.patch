+def configure_compose(original, host_folder):
+    value = copy.deepcopy(original)
+    predictor = value['services']['predictor']
+    env = predictor.setdefault('environment', {})
+    require(isinstance(env, dict) and 'VLLM_TUNED_CONFIG_FOLDER' not in env,
+            'Baseline predictor must not already select a tuned folder')
+    mounts = predictor.setdefault('volumes', [])
+    require(isinstance(mounts, list) and not any(CONTAINER_FOLDER in str(x) for x in mounts),
+            'Tuned mount destination already exists')
+    env['VLLM_TUNED_CONFIG_FOLDER'] = CONTAINER_FOLDER
+    mounts.append({'type': 'bind', 'source': str(host_folder), 'target': CONTAINER_FOLDER, 'read_only': True})
+    return value
