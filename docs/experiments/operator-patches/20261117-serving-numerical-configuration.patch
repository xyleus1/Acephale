+def numerical_attestation(scope, policy_hash, observations, effective_compose_sha, config_sha, actor_id):
+    require(set(observations) == {'baselineBefore', 'baselineAfter', 'configuredBefore', 'configuredAfter'},
+            'All four exact recipe observations required')
+    for key, value in observations.items():
+        configured = key.startswith('configured')
+        require(value['inspection']['configured'] is configured and value['resolver']['configured'] is configured,
