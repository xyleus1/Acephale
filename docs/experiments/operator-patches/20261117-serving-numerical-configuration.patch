+def leaf(batch, split):
+    return {'block_m': 32, 'block_n': 16, 'block_k': 256 if batch < 128 else 32,
+            'split_k': split, 'num_warps': 4, 'num_ctas': 1, 'group_size_m': 8,
+            'num_stages': 2, 'max_nreg': None}
