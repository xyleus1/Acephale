{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalspec.local/contracts/v1",
  "title": "GoalSpecV1",
  "$defs": {
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "maxItems": 8
        }
      },
      "required": [
        "sourceId",
        "path"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "authorizationVersion": {
          "type": "string",
          "minLength": 1
        },
        "environmentVersion": {
          "type": "string",
          "minLength": 1
        },
        "toolSchemaHash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenantId",
        "principalId",
        "authorizationVersion",
        "environmentVersion",
        "toolSchemaHash"
      ],
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 1
              }
            },
            "required": [
              "text",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "objective",
        "probability",
        "sources",
        "constraints"
      ],
      "additionalProperties": false
    },
    "GoalSet": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Goal"
          },
          "maxItems": 3
        },
        "unknown": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "revisionHash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "hypotheses",
        "unknown",
        "revisionHash"
      ],
      "additionalProperties": false
    },
    "ExecutionFrame": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "requestedObjective": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        },
        "goals": {
          "$ref": "#/$defs/GoalSet"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "boundary",
        "scope",
        "requestedObjective",
        "policy",
        "sources",
        "goals",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "Invocation": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "tool",
        "arguments",
        "scope"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "$ref": "#/$defs/Invocation"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "hop": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "patternId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "invocation",
        "probability",
        "bindings",
        "hop",
        "patternId"
      ],
      "additionalProperties": false
    },
    "WorkflowPattern": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "verificationTier": {
          "enum": [
            "source_reported",
            "independent_replay",
            "native_verified"
          ]
        },
        "prefix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 6
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/Json"
        },
        "dataDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policyPrerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observedOrdering": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "successes": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "scope",
        "snapshotId",
        "verificationTier",
        "prefix",
        "tool",
        "binding",
        "dataDependencies",
        "policyPrerequisites",
        "observedOrdering",
        "branches",
        "successes",
        "failures"
      ],
      "additionalProperties": false
    },
    "EvidenceEnvelope": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "$ref": "#/$defs/Invocation"
        },
        "observation": {
          "$ref": "#/$defs/Json"
        },
        "observationHash": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0
        },
        "validatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "validation": {
          "enum": [
            "fresh",
            "replaced"
          ]
        },
        "physicalCalls": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "invocation",
        "observation",
        "observationHash",
        "observedAt",
        "validatedAt",
        "validation",
        "physicalCalls"
      ],
      "additionalProperties": false
    },
    "Outcome": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "requestedObjective": {
          "type": "string",
          "minLength": 1
        },
        "inferredGoals": {
          "$ref": "#/$defs/GoalSet"
        },
        "achievedOutcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independentVerdict": {
          "type": "object",
          "properties": {
            "verifierId": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "boolean"
            },
            "constraintsSatisfied": {
              "type": "boolean"
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "verifierId",
            "success",
            "constraintsSatisfied",
            "evidenceRefs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "requestedObjective",
        "inferredGoals",
        "achievedOutcomes",
        "independentVerdict"
      ],
      "additionalProperties": false
    },
    "ExperimentManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "datasetHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "actorModel": {
          "const": "gpt-5.4-2026-03-05"
        },
        "predictorModel": {
          "const": "gpt-4.1-mini-2025-04-14"
        },
        "embeddingModel": {
          "const": "text-embedding-3-small"
        },
        "embeddingDimensions": {
          "const": 1536
        },
        "actorReasoning": {
          "const": "medium"
        },
        "actorOutputCap": {
          "const": 4096
        },
        "predictorOutputCap": {
          "const": 1024
        },
        "actorInputBudget": {
          "const": 32768
        },
        "predictorInputBudget": {
          "const": 8192
        },
        "arms": {
          "const": [
            "base",
            "neutral_memory_prefetch",
            "goalspec"
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "frozen": {
          "const": true
        },
        "totalCeilingUsd": {
          "const": 500
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "snapshotId",
        "datasetHashes",
        "sourceRevision",
        "actorModel",
        "predictorModel",
        "embeddingModel",
        "embeddingDimensions",
        "actorReasoning",
        "actorOutputCap",
        "predictorOutputCap",
        "actorInputBudget",
        "predictorInputBudget",
        "arms",
        "seeds",
        "frozen",
        "totalCeilingUsd"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Goal"
    },
    {
      "$ref": "#/$defs/GoalSet"
    },
    {
      "$ref": "#/$defs/ExecutionFrame"
    },
    {
      "$ref": "#/$defs/Invocation"
    },
    {
      "$ref": "#/$defs/Candidate"
    },
    {
      "$ref": "#/$defs/WorkflowPattern"
    },
    {
      "$ref": "#/$defs/EvidenceEnvelope"
    },
    {
      "$ref": "#/$defs/Outcome"
    },
    {
      "$ref": "#/$defs/ExperimentManifest"
    }
  ]
}
