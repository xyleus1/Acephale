{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://derya.local/goalspec/v4-controller.schema.json",
  "title":"GoalSpecControllerV4",
  "oneOf":[{"$ref":"#/$defs/DecisionState"},{"$ref":"#/$defs/CandidateFeatures"},{"$ref":"#/$defs/ControllerScores"},{"$ref":"#/$defs/ControllerDecision"},{"$ref":"#/$defs/ControllerArtifact"}],
  "$defs":{
    "Strings":{"type":"array","items":{"type":"string"}},
    "Probability":{"type":"number","minimum":0,"maximum":1},
    "DecisionState":{"type":"object","additionalProperties":false,"required":["version","boundary","requestedObjective","activeGoals","unresolvedRequirements","recentTools","sourceIds","visibleText","unknownGoal"],"properties":{"version":{"const":"goalspec-decision-state-v1"},"boundary":{"type":"integer","minimum":0},"requestedObjective":{"type":"string"},"activeGoals":{"$ref":"#/$defs/Strings"},"unresolvedRequirements":{"$ref":"#/$defs/Strings"},"recentTools":{"$ref":"#/$defs/Strings"},"sourceIds":{"$ref":"#/$defs/Strings"},"visibleText":{"type":"string"},"unknownGoal":{"$ref":"#/$defs/Probability"}}},
    "CandidateFeatures":{"type":"object","additionalProperties":false,"required":["version","candidateId","values"],"properties":{"version":{"const":"goalspec-controller-features-v1"},"candidateId":{"type":"string"},"values":{"type":"array","items":{"type":"number"},"minItems":216,"maxItems":216}}},
    "CandidateScore":{"type":"object","additionalProperties":false,"required":["candidateId","nextAction","usefulWithin2","readiness","exposure"],"properties":{"candidateId":{"type":"string"},"nextAction":{"$ref":"#/$defs/Probability"},"usefulWithin2":{"$ref":"#/$defs/Probability"},"readiness":{"$ref":"#/$defs/Probability"},"exposure":{"anyOf":[{"$ref":"#/$defs/Probability"},{"type":"null"}]}}},
    "ControllerScores":{"type":"object","additionalProperties":false,"required":["actionRead","candidates","elapsedMs"],"properties":{"actionRead":{"$ref":"#/$defs/Probability"},"candidates":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/CandidateScore"}},"elapsedMs":{"type":"number","minimum":0}}},
    "ControllerDecision":{"type":"object","additionalProperties":false,"required":["version","action","rankedCandidateIds","exposeCandidateIds","scores","artifactHash"],"properties":{"version":{"const":"goalspec-controller-decision-v1"},"action":{"enum":["read","NO_READ","defer"]},"rankedCandidateIds":{"type":"array","maxItems":3,"items":{"type":"string"}},"exposeCandidateIds":{"type":"array","maxItems":2,"items":{"type":"string"}},"scores":{"$ref":"#/$defs/ControllerScores"},"artifactHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "DenseLayer":{"type":"object","additionalProperties":false,"required":["weights","bias","activation"],"properties":{"weights":{"type":"array","maxItems":128,"minItems":1,"items":{"type":"array","minItems":1,"maxItems":216,"items":{"type":"number"}}},"bias":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"number"}},"activation":{"enum":["relu","linear"]}}},
    "ControllerArtifact":{"type":"object","additionalProperties":false,"required":["version","featureVersion","goalFeaturePolicy","inputDimension","architecture","layers","heads","trainedHeads","calibration","thresholds","lineage","contentHash"],"properties":{
      "goalFeaturePolicy":{"const":"public-request-only"},
      "version":{"const":"goalspec-controller-artifact-v1"},"featureVersion":{"const":"goalspec-controller-features-v1"},"inputDimension":{"const":216},"architecture":{"enum":["logistic","mlp-32-16"]},"layers":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/DenseLayer"}},"heads":{"type":"array","minItems":5,"maxItems":5,"items":{"enum":["actionRead","nextAction","usefulWithin2","readiness","exposure"]}},
      "trainedHeads":{"type":"object","additionalProperties":false,"required":["actionRead","nextAction","usefulWithin2","readiness","exposure"],"properties":{"actionRead":{"type":"boolean"},"nextAction":{"type":"boolean"},"usefulWithin2":{"type":"boolean"},"readiness":{"type":"boolean"},"exposure":{"type":"boolean"}}},
      "calibration":{"type":"object","additionalProperties":false,"required":["temperature","bias","method"],"properties":{"temperature":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"number","exclusiveMinimum":0}},"bias":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"number"}},"method":{"const":"family-heldout-temperature-grid"}}},
      "thresholds":{"type":"object","additionalProperties":false,"required":["actionRead","usefulWithin2","readiness","exposure"],"properties":{"actionRead":{"$ref":"#/$defs/Probability"},"usefulWithin2":{"$ref":"#/$defs/Probability"},"readiness":{"$ref":"#/$defs/Probability"},"exposure":{"$ref":"#/$defs/Probability"}}},
      "lineage":{"type":"object","additionalProperties":false,"required":["datasetHash","trainFamilies","selectionFamilies","calibrationFamilies","baseOnly","seed","selectedCheckpoint","soupMembers","randomizedExposureDataHash","labelSemantics"],"properties":{"datasetHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"trainFamilies":{"$ref":"#/$defs/Strings"},"selectionFamilies":{"$ref":"#/$defs/Strings"},"calibrationFamilies":{"$ref":"#/$defs/Strings"},"baseOnly":{"const":true},"seed":{"type":"integer"},"selectedCheckpoint":{"type":"string"},"soupMembers":{"$ref":"#/$defs/Strings"},"randomizedExposureDataHash":{"anyOf":[{"type":"string","pattern":"^[a-f0-9]{64}$"},{"type":"null"}]},"labelSemantics":{"const":"next-action-imitation;within-two-observed-use;readiness-is-not-authorization;exposure-masked"}}},
      "contentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
    }}
  }
}
